# Read by Cloudflare Pages (ignored, and harmlessly served as text, on other hosts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro fingerprints everything in /_astro/, so it can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
