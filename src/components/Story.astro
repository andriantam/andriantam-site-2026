---
// The home page story: full-screen chapters you swipe (or scroll) through, one per stage of the career.
// The stage is pinned while the page scrolls past it; each chapter's position in the swipe drives its
// camera move, wipe transition and set piece, so the whole thing scrubs back and forth like footage.
import { Image } from "astro:assets";
import FlickrImg from "./FlickrImg.astro";
import type { FlickrPhoto } from "../lib/flickr";

import mountains from "../assets/photos/mountains.jpg";
import portfolio from "../assets/photos/portfolio-header.jpg";
import laptop from "../assets/photos/laptop.jpg";
import events from "../assets/photos/events-header.jpg";
import walking from "../assets/photos/hero-bg.jpg";
import me from "../assets/photos/me.jpg";
import showroom from "../assets/photos/cabinetry-showroom.jpg";
import mckTeam from "../assets/photos/mckinsey-team.jpg";

interface Props {
  prints: { title: string; cover: FlickrPhoto }[];
}
const { prints } = Astro.props;

const CHAPTERS = [
  { id: "intro", rail: "Start" },
  { id: "camera", rail: "2010" },
  { id: "uni", rail: "2012" },
  { id: "agency", rail: "2015" },
  { id: "mckinsey", rail: "2018" },
  { id: "founder", rail: "2024" },
  { id: "brand", rail: "2026" },
  { id: "next", rail: "Next" },
];
const N = CHAPTERS.length;

const CODE = `<section class="campaign">
  <h1 data-split>Goodbye, Good Buy</h1>
  <button class="cta" onclick="play()">Watch</button>
</section>
<script>
  const ir = new InfraredTrigger({ pin: 7 });
  ir.on("break", () => scene.next());
</script>`;

const prints6 = prints.slice(0, 6);
const SCATTER = [
  [-14, -18, -9],
  [6, -24, 5],
  [24, -14, 11],
  [-8, 6, 7],
  [12, 4, -4],
  [28, 12, -10],
];
---

<section class="story" data-story aria-label="My story" style={`--n:${N}`}>
  <div class="track">
    {CHAPTERS.map((_, i) => <div class="snap" style={`top:${i * 100}svh`} aria-hidden="true" />)}
    <div class="stage">
      <!-- 00 Intro -->
      <article class="ch ch-intro" data-ch="0" style="z-index:1" aria-labelledby="st-intro">
        <div class="bg">
          <video
            class="move"
            data-intro-video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/media/hero-poster-1280.webp"
            aria-label="A slow push in towards a lone figure on a misty mountain ridge"
          >
            <source src="/media/hero-540.mp4" type="video/mp4" media="(orientation: portrait)" />
            <source src="/media/hero-1280.mp4" type="video/mp4" />
          </video>
          <div class="shade" style="--dim:0.45"></div>
        </div>
        <div class="copy wrap center">
          <p class="eyebrow">Photographer · Engineer · Brand builder</p>
          <h1 id="st-intro" class="title"><img class="wordmark" data-intro-mark src="/wordmark.png" alt="andriantam" width="2400" height="196" /></h1>
          <p class="lede" data-intro-lede>Fifteen years behind the camera, a decade of building software. Here's how the two came together.</p>
        </div>
        <p class="hint" aria-hidden="true"><span><span class="touch-only">Swipe up</span><span class="mouse-only">Scroll</span> for the story</span><i></i></p>
      </article>

      <!-- 01 High school: the first camera -->
      <article class="ch ch-camera" data-ch="1" style="z-index:2" aria-labelledby="st-camera">
        <div class="bg">
          <Image src={mountains} alt="" widths={[640, 1280, 1920, 2560]} sizes="100vw" class="move focus" loading="lazy" format="avif" />
          <div class="shade" style="--dim:0.25"></div>
        </div>
        <div class="vf" aria-hidden="true">
          <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
          <div class="af" data-af></div>
          <p class="vf-read"><span>1/250</span><span>f/8</span><span>ISO 100</span><span class="dot"></span></p>
        </div>
        <div class="copy wrap">
          <p class="eyebrow">2010 · High school</p>
          <h2 id="st-camera">It started with a <em>camera.</em></h2>
          <p class="lede">
            I've been shooting since my high school days at SMK Seafield. As a kid I spent hours in bookshops reading photography
            magazines, studying how each shot was made and dreaming about cameras I couldn't afford. I started on compact cameras and
            borrowed DSLRs until my brother bought me my first, a Canon 500D.
          </p>
        </div>
      </article>

      <!-- 02 University: photography everywhere -->
      <article class="ch ch-uni" data-ch="2" style="z-index:3" aria-labelledby="st-uni">
        <div class="bg">
          <Image src={portfolio} alt="" widths={[640, 1280, 1920]} sizes="100vw" class="move blurred" loading="lazy" format="avif" />
          <div class="shade" style="--dim:0.72"></div>
        </div>
        <ul class="prints" aria-hidden="true">
          {
            prints6.map((p, i) => (
              <li style={`--dx:${SCATTER[i][0]}vw;--dy:${SCATTER[i][1]}svh;--rot:${SCATTER[i][2]}deg;--k:${i}`}>
                <FlickrImg photo={p.cover} alt="" sizes="(min-width: 900px) 22vw, 40vw" />
                <span>{p.title}</span>
              </li>
            ))
          }
        </ul>
        <div class="copy wrap">
          <p class="eyebrow">2012 to 2015 · University</p>
          <h2 id="st-uni">Then I photographed <em>everything.</em></h2>
          <p class="lede">
            Photography stayed close to my heart. I shot mostly landscapes and travel, and while studying Cognitive Science at
            UNIMAS, I covered many events for my faculty and the university.
          </p>
        </div>
      </article>

      <!-- 03 Ad agency: UI/UX and interactive sites -->
      <article class="ch ch-agency" data-ch="3" style="z-index:4" aria-labelledby="st-agency">
        <div class="bg">
          <Image src={laptop} alt="" widths={[640, 1280, 1920, 2560]} sizes="100vw" class="move" loading="lazy" format="avif" />
          <div class="shade" style="--dim:0.62"></div>
        </div>
        <div class="build" aria-hidden="true">
          <div class="win">
            <div class="win-bar"><i></i><i></i><i></i><span>goodbye-good-buy.com.my</span></div>
            <div class="win-body">
              <div class="wire">
                <b class="w-nav"></b><b class="w-hero"></b><b class="w-l1"></b><b class="w-l2"></b><b class="w-btn"></b>
                <b class="w-c1"></b><b class="w-c2"></b><b class="w-c3"></b>
              </div>
              <div class="skin">
                <p class="s-nav"><span>●</span> Campaign <span>Watch · Trade in · Stores</span></p>
                <p class="s-hero">Goodbye,<br /><em>Good Buy</em></p>
                <p class="s-btn">Watch the film</p>
                <div class="s-cards"><i></i><i></i><i></i></div>
              </div>
            </div>
          </div>
          <pre class="code"><code data-code data-src={CODE}></code><span class="caret"></span></pre>
          <p class="badge"><b>Silver</b> Malaysia Effie Awards 2017</p>
        </div>
        <div class="copy wrap">
          <p class="eyebrow">2015 to 2017 · Software engineer, ad agency</p>
          <h2 id="st-agency">I learned to build what people <em>touch.</em></h2>
          <p class="lede">
            I started out as a software engineer and fell for UI/UX: interfaces that respond, move and feel right. At Isobar, part of
            Dentsu Aegis Network, I built interactive sites and campaigns for brands, down to an Arduino infrared trigger for an
            on-ground installation.
          </p>
        </div>
      </article>

      <!-- 04 McKinsey: serious business, financial services -->
      <article class="ch ch-mck" data-ch="4" style="z-index:5" aria-labelledby="st-mck">
        <div class="bg dark">
          <Image src={mckTeam} alt="" widths={[640, 1280, 1920]} sizes="100vw" class="move" style="object-position:28% 62%" loading="lazy" format="avif" />
          <div class="tint"></div>
          <div class="grid-bg"></div>
        </div>
        <div class="dash" aria-hidden="true" data-dash>
          <div class="panel p-risk">
            <p class="p-h">Risk monitor <span class="live">Live</span></p>
            <ul data-risk>
              <li><span>Credit exposure</span><b data-v>72</b><svg viewBox="0 0 100 24" preserveAspectRatio="none"><path /></svg></li>
              <li><span>Liquidity</span><b data-v>41</b><svg viewBox="0 0 100 24" preserveAspectRatio="none"><path /></svg></li>
              <li><span>Market</span><b data-v>58</b><svg viewBox="0 0 100 24" preserveAspectRatio="none"><path /></svg></li>
              <li><span>Operational</span><b data-v>23</b><svg viewBox="0 0 100 24" preserveAspectRatio="none"><path /></svg></li>
            </ul>
          </div>
          <div class="panel p-asset">
            <p class="p-h">Asset health</p>
            <div class="gauges">
              {["Haul truck 14", "Conveyor B", "Crusher 2"].map((g, i) => (
                <div class="gauge" data-gauge style={`--g:${[0.86, 0.64, 0.92][i]}`}>
                  <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15.9" /><circle class="arc" cx="18" cy="18" r="15.9" pathLength="100" /></svg>
                  <b data-gv>{Math.round([0.86, 0.64, 0.92][i] * 100)}%</b>
                  <span>{g}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="panel p-map">
            <p class="p-h">Delivery</p>
            <div class="cities">
              {["Kuala Lumpur", "Jakarta", "Sydney", "Hong Kong", "Bangkok", "Taipei", "Amsterdam"].map((c) => <span>{c}</span>)}
            </div>
          </div>
          <p class="note">Illustrative data</p>
        </div>
        <div class="copy wrap">
          <p class="eyebrow">2018 to 2024 · McKinsey &amp; Company</p>
          <h2 id="st-mck">Then the stakes got <em>serious.</em></h2>
          <p class="lede">
            Six years as a software engineer in McKinsey's digital practice, much of it for financial services. I led 15 engineers on
            a bank's app that launched just as the COVID-19 lockdown hit, built a risk monitor for a Sydney client, and worked on
            asset health monitoring and digital lending in Jakarta.
          </p>
        </div>
      </article>

      <!-- 05 Founder: media, and cabinetry & interiors -->
      <article class="ch ch-founder" data-ch="5" style="z-index:6" aria-labelledby="st-founder">
        <div class="bg split">
          <div class="half media">
            <Image src={events} alt="" widths={[640, 1280, 1920]} sizes="(min-width: 800px) 50vw, 100vw" class="move" loading="lazy" format="avif" />
          </div>
          <div class="half interior">
            <Image src={showroom} alt="Andrian walking a group of students through cabinet finishes in a showroom" widths={[640, 1000, 1400]} sizes="(min-width: 800px) 50vw, 100vw" class="move" style="object-position:32% 55%" loading="lazy" format="avif" />
          </div>
          <div class="shade" style="--dim:0.45"></div>
        </div>
        <p class="tag t-media" aria-hidden="true">Toge · Media</p>
        <p class="tag t-int" aria-hidden="true">Cabinetry &amp; interiors</p>
        <div class="copy wrap">
          <p class="eyebrow">2024 to 2026 · Founder, then business development</p>
          <h2 id="st-founder">So I built my <em>own.</em></h2>
          <p class="lede">
            I founded Toge, a media-driven marketing consultancy and the official media for Autoshow Malaysia, Super GT Sepang and
            Tokyo Auto Salon. Then I led business development at a cabinetry company, taking a traditional business digital and
            growing its viewership fifty times.
          </p>
        </div>
      </article>

      <!-- 06 Head of Brand -->
      <article class="ch ch-brand" data-ch="6" style="z-index:7" aria-labelledby="st-brand">
        <div class="bg">
          <Image src={walking} alt="" widths={[640, 1280, 1920, 2560]} sizes="100vw" class="move" style="object-position:40% 40%" loading="lazy" format="avif" />
          <div class="shade" style="--dim:0.5"></div>
        </div>
        <ul class="chips" aria-hidden="true">
          {["Brand", "Customer data", "AI video", "UI/UX", "Engineering", "Photography"].map((c, k) => <li style={`--k:${k}`}>{c}</li>)}
        </ul>
        <div class="copy wrap">
          <p class="eyebrow">2026 · Head of Brand, TROOPERS Singapore</p>
          <h2 id="st-brand">Back in the team, still <em>building.</em></h2>
          <p class="lede">
            Today I lead brand at TROOPERS in Singapore, and I still build the tech behind it: a customer data platform for
            retargeting and lead quality, and AI video editing that cut three days of work to three hours.
          </p>
        </div>
      </article>

      <!-- 07 Next -->
      <article class="ch ch-next" data-ch="7" style="z-index:8" aria-labelledby="st-next">
        <div class="bg">
          <Image src={me} alt="andriantam with a camera and backpack on a cobbled street" widths={[480, 960, 1333]} sizes="100vw" class="move" style="object-position:50% 10%" loading="lazy" format="avif" />
          <div class="shade" style="--dim:0.58"></div>
        </div>
        <div class="copy wrap center">
          <p class="eyebrow">What's next</p>
          <h2 id="st-next" class="title">Let's build <em>something.</em></h2>
          <p class="lede">Brand, tech, or both. And if you want to talk photography, the coffee's on me.</p>
          <p class="ctas">
            <a class="btn btn-primary" href="#contact">Contact me</a>
            <a class="btn" href="/photography">See the photography</a>
            <a class="btn" href="/resume">Read the resume</a>
          </p>
        </div>
      </article>

      <nav class="rail" aria-label="Story chapters">
        <ol>
          {CHAPTERS.map((c, i) => (
            <li><button type="button" data-goto={i} aria-label={`Chapter ${i + 1}: ${c.rail}`}><span>{c.rail}</span></button></li>
          ))}
        </ol>
      </nav>
      <div class="progress" aria-hidden="true"><i data-progress></i></div>
    </div>
  </div>
</section>

<style>
  .story {
    position: relative;
    background: #000;
  }
  .track {
    position: relative;
    height: calc(var(--n) * 100svh);
  }
  .snap {
    position: absolute;
    left: 0;
    width: 1px;
    height: 100svh;
    scroll-snap-align: start;
    pointer-events: none;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    contain: layout paint;
  }

  /* Each chapter: --q is its place in the swipe (-1 entering, 0 centred, 1 leaving), --a its presence (0..1),
     --in how far it has come in (0..1). Set by the script. */
  .ch {
    --q: 1;
    --a: 0;
    --in: 0;
    --enter: max(0, -1 * var(--q));
    --leave: max(0, var(--q));
    position: absolute;
    inset: 0;
    visibility: hidden;
    clip-path: inset(calc(var(--enter) * 100%) 0 0 0);
    color: #fff;
  }
  .ch:global([data-on]) {
    visibility: visible;
  }
  .bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0b0a0e;
  }
  .bg :global(.move) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* A slow camera move through the chapter, pushing in harder as it leaves. */
    transform: translateY(calc(var(--q) * -5%)) scale(calc(1.1 + var(--leave) * 0.18 + var(--enter) * 0.06));
    will-change: transform;
  }
  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.1) 55%),
      rgba(0, 0, 0, calc(var(--dim) + var(--leave) * 0.5));
  }
  .copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(5.5rem, 14svh, 9rem);
    opacity: var(--a);
    transform: translateY(calc(var(--q) * -70px));
  }
  .copy > * {
    max-width: 38rem;
  }
  .copy.center {
    bottom: auto;
    top: 50%;
    translate: 0 -50%;
    text-align: center;
  }
  .copy.center > * {
    margin-inline: auto;
  }
  .copy.center > .title {
    max-width: none;
  }
  .eyebrow {
    color: var(--gold);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 0.8rem;
  }
  h2,
  .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.2rem, 6.4vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }
  .title {
    font-size: clamp(3rem, 11vw, 8rem);
  }
  /* The opening title is the andriantam wordmark */
  .title .wordmark {
    display: block;
    width: var(--lede-w, min(78vw, 52rem)); /* set by script to the description's widest line */
    height: auto;
    margin: 0.4em auto 0.15em;
  }
  h2 em,
  .title em {
    font-style: italic;
    color: var(--gold);
  }
  .lede {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-top: 1.6rem !important;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    translate: -50% 0;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    opacity: calc(var(--a) * 1);
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    text-align: center;
  }
  .hint i {
    width: 1px;
    height: 34px;
    background: linear-gradient(to bottom, #fff, transparent);
    animation: drip 1.8s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
  .touch-only {
    display: none;
  }
  @media (pointer: coarse) {
    .touch-only {
      display: inline;
    }
    .mouse-only {
      display: none;
    }
  }

  /* 01 Viewfinder: focus pulls in as the chapter arrives */
  .ch-camera :global(.focus) {
    filter: blur(calc((1 - var(--in)) * 16px));
  }
  .vf {
    position: absolute;
    inset: clamp(4.5rem, 10svh, 6rem) clamp(1rem, 5vw, 4rem) clamp(1rem, 4svh, 2.5rem);
    opacity: calc(var(--a) * 0.95);
    pointer-events: none;
  }
  .vf .c {
    position: absolute;
    width: 28px;
    height: 28px;
    border: 2px solid rgba(255, 255, 255, 0.85);
  }
  .tl {
    top: 0;
    left: 0;
    border-right: 0 !important;
    border-bottom: 0 !important;
  }
  .tr {
    top: 0;
    right: 0;
    border-left: 0 !important;
    border-bottom: 0 !important;
  }
  .bl {
    bottom: 0;
    left: 0;
    border-right: 0 !important;
    border-top: 0 !important;
  }
  .br {
    bottom: 0;
    right: 0;
    border-left: 0 !important;
    border-top: 0 !important;
  }
  .af {
    position: absolute;
    left: 58%;
    top: 34%;
    width: clamp(46px, 7vw, 80px);
    aspect-ratio: 1;
    border: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 3px;
    transform: scale(calc(1.6 - var(--in) * 0.6));
    transition: border-color 0.15s;
  }
  .af:global(.locked) {
    border-color: #6ee07a;
  }
  .vf-read {
    position: absolute;
    right: 0.4rem;
    top: 0.3rem;
    display: flex;
    gap: 0.9rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }
  .vf-read .dot {
    width: 8px;
    height: 8px;
    margin-top: 0.35em;
    border-radius: 50%;
    background: #ff5a4a;
  }

  /* 02 Prints fan out from a pile */
  .ch-uni :global(.blurred) {
    filter: blur(6px) saturate(0.7);
  }
  .prints {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0 0 32svh;
  }
  .prints li {
    position: absolute;
    left: 62%;
    top: 52%;
    width: clamp(130px, 22vw, 300px);
    padding: 8px 8px 26px;
    background: #f6f3ee;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.7);
    transform: translate(-50%, -50%)
      translate(calc(var(--dx) * var(--sx, 1) * var(--in)), calc(var(--dy) * var(--sy, 1) * var(--in) - var(--leave) * (60svh + var(--k) * 6svh)))
      rotate(calc(var(--rot) * var(--in) + var(--k) * 3deg * (1 - var(--in))));
    opacity: calc(min(1, var(--in) * 3) * (1 - var(--leave) * 0.6));
  }
  .prints :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .prints span {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 6px;
    font-size: 0.62rem;
    color: #3a3640;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 03 A website builds itself: wireframe, then design, while the code types */
  .build {
    position: absolute;
    top: clamp(5rem, 13svh, 8rem);
    right: clamp(1rem, 5vw, 5rem);
    width: min(560px, 50vw);
    opacity: min(1, calc(var(--in) * 2));
    transform: translateY(calc(var(--q) * 40px));
  }
  .win {
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 30px 80px -20px #000;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #ececec;
    font-size: 0.62rem;
    color: #666;
  }
  .win-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ccc;
  }
  .win-bar span {
    margin-left: 10px;
    padding: 2px 10px;
    border-radius: 5px;
    background: #fff;
  }
  .win-body {
    position: relative;
    aspect-ratio: 16 / 10;
  }
  .wire,
  .skin {
    position: absolute;
    inset: 0;
  }
  .wire b {
    position: absolute;
    background: #e3e3e8;
    border-radius: 3px;
    transform-origin: left;
  }
  .w-nav {
    left: 5%;
    right: 5%;
