<script>
  // The opening wordmark is exactly as wide as the description's widest line.
  {
    const lede = document.querySelector<HTMLElement>("[data-intro-lede]");
    const mark = document.querySelector<HTMLElement>("[data-intro-mark]");
    if (lede && mark) {
      // Measure word by word and group by line: the visible text width, the same in every browser
      // (Safari can report a whole wrapped line as the full paragraph width).
      const fit = () => {
        const text = lede.firstChild;
        if (!text || text.nodeType !== Node.TEXT_NODE) return;
        const str = text.textContent ?? "";
        const r = document.createRange();
        const lines = new Map<number, [number, number]>();
        const re = /\S+/g;
        let m: RegExpExecArray | null;
        while ((m = re.exec(str))) {
          r.setStart(text, m.index);
          r.setEnd(text, m.index + m[0].length);
          const b = r.getBoundingClientRect();
          const key = Math.round(b.top);
          const l = lines.get(key);
          lines.set(key, l ? [Math.min(l[0], b.left), Math.max(l[1], b.right)] : [b.left, b.right]);
        }
        const w = Math.max(0, ...[...lines.values()].map(([a, b]) => b - a));
        if (w > 0) mark.style.setProperty("--lede-w", `${Math.floor(w)}px`);
      };
      fit();
      new ResizeObserver(fit).observe(lede);
      let t = 0;
      addEventListener("resize", () => (clearTimeout(t), (t = window.setTimeout(fit, 150))));
      document.fonts?.ready.then(fit);
    }
  }

  const story = document.querySelector<HTMLElement>("[data-story]");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (story && !reduced) initStory(story);

  function initStory(story: HTMLElement) {
    const track = story.querySelector<HTMLElement>(".track")!;
    const stage = story.querySelector<HTMLElement>(".stage")!;
    const chapters = [...story.querySelectorAll<HTMLElement>(".ch")];
    const rail = [...story.querySelectorAll<HTMLButtonElement>("[data-goto]")];
    const bar = story.querySelector<HTMLElement>("[data-progress]")!;
    const n = chapters.length;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    let top = 0, vh = 1, active = -1, raf = 0;

    const measure = () => {
      vh = stage.clientHeight || innerHeight;
      top = track.getBoundingClientRect().top + scrollY;
    };

    // Set pieces that need script.
    const af = story.querySelector<HTMLElement>("[data-af]");
    const code = story.querySelector<HTMLElement>("[data-code]");
    const src = code?.dataset.src ?? "";
    let typed = -1;
    const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
    // One pass, so the markup it adds is never matched again.
    const highlight = (s: string) =>
      s.replace(/(<\/?[a-z]+)|("[^"\n]*"?)|([^<"]+|[<"])/g, (_, tag, str, rest) =>
        tag ? `<span class="k">${esc(tag)}</span>` : str ? `<span class="s">${esc(str)}</span>` : esc(rest),
      );

    function frame() {
      raf = 0;
      const t = clamp((scrollY - top) / vh, 0, n - 1);
      chapters.forEach((c, i) => {
        const q = clamp(t - i, -1.2, 1.2);
        const on = Math.abs(q) < 1;
        c.toggleAttribute("data-on", on);
        if (!on && !c.style.getPropertyValue("--q")) return;
        c.style.setProperty("--q", q.toFixed(4));
        c.style.setProperty("--a", clamp(1 - Math.abs(q) * 1.8, 0, 1).toFixed(3));
        c.style.setProperty("--in", clamp(q + 1, 0, 1).toFixed(4));
      });
      bar.style.setProperty("--p", (t / (n - 1)).toFixed(4));
      const a = Math.round(t);
      if (a !== active) {
        active = a;
        rail.forEach((b, i) => (i === a ? b.setAttribute("aria-current", "step") : b.removeAttribute("aria-current")));
      }
      // 01: autofocus locks once the chapter settles
      af?.classList.toggle("locked", Math.abs(t - 1) < 0.12);
      // 03: the code types itself as you swipe in (and un-types as you swipe back)
      if (code) {
        const k = Math.round(src.length * clamp((t - 2) / 0.9, 0, 1));
        if (k !== typed) {
          typed = k;
          code.innerHTML = highlight(src.slice(0, k));
        }
      }
      dashLive(Math.abs(t - 4) < 1);
    }
    const request = () => (raf ||= requestAnimationFrame(frame));

    // 04: dashboard values tick while it's on screen.
    const rows = [...story.querySelectorAll<HTMLElement>("[data-risk] li")].map((li) => ({
      v: li.querySelector<HTMLElement>("[data-v]")!,
      path: li.querySelector("path")!,
      series: Array.from({ length: 24 }, () => 0),
      base: Number(li.querySelector<HTMLElement>("[data-v]")!.textContent),
    }));
    rows.forEach((r) => (r.series = r.series.map((_, i) => r.base + Math.sin(i * 0.7 + r.base) * 8)));
    let dashTimer = 0;
    function dashLive(on: boolean) {
      if (on && !dashTimer) {
        tick();
        dashTimer = window.setInterval(tick, 900);
      } else if (!on && dashTimer) {
        clearInterval(dashTimer);
        dashTimer = 0;
      }
    }
    function tick() {
      for (const r of rows) {
        const last = r.series[r.series.length - 1];
        const next = clamp(last + (Math.random() - 0.5) * 9 + (r.base - last) * 0.15, 5, 98);
        r.series.push(next);
        r.series.shift();
        r.v.textContent = String(Math.round(next));
        r.v.classList.toggle("hi", next > 70);
        r.path.setAttribute("d", r.series.map((y, i) => `${i ? "L" : "M"}${((i / 23) * 100).toFixed(1)} ${(24 - (y / 100) * 22).toFixed(1)}`).join(" "));
      }
    }

    // Rail: jump to a chapter.
    rail.forEach((b, i) => b.addEventListener("click", () => go(i)));

    // When a swipe or scroll ends inside the story, settle on a chapter. Moving more than a little
    // (12% of a screen) away from the chapter you were on carries on to the next one in that direction,
    // so one short swipe on a phone is enough; smaller nudges fall back to where you were.
    let settleTimer = 0;
    let from = Math.round(clamp((scrollY - top) / vh, 0, n - 1));
    let touching = false;

    // Touch screens: inside the story, one swipe is one chapter, however hard the flick. The page's own
    // scrolling (and its momentum) is held back and the swipe's direction picks the next chapter. At the
    // first and last chapter, a swipe out of the story scrolls the page normally.
    const go = (i: number) => {
      from = clamp(i, 0, n - 1);
      scrollTo({ top: top + from * vh, behavior: "smooth" });
    };
    let sy = 0, sx = 0, baseY = 0, paging: boolean | null = null;
    const inStory = () => {
      const raw = (scrollY - top) / vh;
      return raw > -0.02 && raw < n - 1 + 0.02;
    };
    addEventListener("touchstart", (e) => {
      touching = true;
      sy = e.touches[0].clientY;
      sx = e.touches[0].clientX;
      baseY = scrollY;
      paging = e.touches.length === 1 && inStory() ? null : false;
    }, { passive: true });
    addEventListener("touchmove", (e) => {
      if (paging === false) return;
      const dy = sy - e.touches[0].clientY; // > 0: swiping up, towards the next chapter
      if (paging === null) {
        if (Math.abs(dy) < 2 && Math.abs(sx - e.touches[0].clientX) < 2) return e.preventDefault();
        const leaving = (from >= n - 1 && dy > 0) || (from <= 0 && dy < 0);
        paging = !leaving;
        if (!paging) return;
      }
      e.preventDefault();
      // The page follows your finger, up to one chapter either way, until you let go.
      const y = clamp(baseY + dy, Math.max(top, top + (from - 1) * vh), Math.min(top + (n - 1) * vh, top + (from + 1) * vh));
      scrollTo({ top: y, behavior: "instant" });
    }, { passive: false });
    addEventListener("touchend", (e) => {
      touching = false;
      if (paging) {
        paging = null;
        const dy = sy - e.changedTouches[0].clientY;
        go(Math.abs(dy) > 24 ? from + (dy > 0 ? 1 : -1) : from);
        return;
      }
      paging = null;
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 160);
    }, { passive: true });
    addEventListener("touchcancel", () => {
      touching = false;
      if (paging) go(from);
      paging = null;
    }, { passive: true });
    const settle = () => {
      if (touching) return;
      const raw = (scrollY - top) / vh;
      if (raw <= 0.02 || raw >= n - 1 + 0.02) {
        from = Math.round(clamp(raw, 0, n - 1));
        return;
      }
      let target = Math.round(raw);
      if (raw - from > 0.12) target = Math.max(target, from + 1);
      else if (from - raw > 0.12) target = Math.min(target, from - 1);
      target = clamp(target, 0, n - 1);
      from = target;
      if (Math.abs(raw - target) > 0.01) scrollTo({ top: top + target * vh, behavior: "smooth" });
    };
    addEventListener("scroll", () => {
      request();
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(settle, 160);
    }, { passive: true });
    addEventListener("resize", () => (measure(), request()));
    new ResizeObserver(() => (measure(), request())).observe(document.body);

    // Pause the intro video when it's off screen.
    const video = story.querySelector<HTMLVideoElement>("[data-intro-video]");
    if (video) {
      new IntersectionObserver(([e]) => {
        const playing = chapters[0].hasAttribute("data-on") && e.isIntersecting;
        if (playing) video.play().catch(() => {});
        else video.pause();
      }).observe(story);
    }

    measure();
    frame();
  }
</script>
