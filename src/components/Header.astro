---
const links = [
  { href: "/", label: "Home" },
  { href: "/resume", label: "Resume" },
  { href: "/photography", label: "Photography" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/articles", label: "Articles" },
  { href: "/play", label: "Play" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---

<header class="site-header">
  <div class="bar wrap">
    <a href="/" class="brand" aria-label="andriantam, home">
      <span class="mark"><svg viewBox="33 18 473 473" aria-hidden="true"><path fill="currentColor" d="M33 61C70 84 150 96 269.5 96S469 84 506 61V136H33ZM191 136h37v312h-37ZM312 136h38v312h-38Z" /></svg></span>
      <span class="name">andriantam</span>
    </a>
    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav aria-label="Main" id="main-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={active(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a href="/#contact" class="cta">Contact me</a></li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var set = function () {
      document.documentElement.classList.toggle("scrolled", scrollY > 40);
    };
    addEventListener("scroll", set, { passive: true });
    set();
    // Phone menu
    var btn = document.querySelector(".menu-btn");
    var header = document.querySelector(".site-header");
    if (btn && header) {
      var toggle = function (open) {
        header.classList.toggle("menu-open", open);
        btn.setAttribute("aria-expanded", String(open));
        btn.textContent = open ? "Close" : "Menu";
      };
      btn.addEventListener("click", function () {
        toggle(!header.classList.contains("menu-open"));
      });
      header.querySelectorAll("nav a").forEach(function (a) {
        a.addEventListener("click", function () {
          toggle(false);
        });
      });
      addEventListener("keydown", function (e) {
        if (e.key === "Escape") toggle(false);
      });
    }
  })();
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
    background: linear-gradient(to bottom, rgba(11, 10, 14, 0.85), rgba(11, 10, 14, 0));
  }
  /* Once you scroll, the header gets a solid backdrop so content never runs under the nav. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(11, 10, 14, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(html.scrolled) .site-header::before {
    opacity: 1;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text);
    flex-shrink: 0;
  }
  .mark {
    width: 34px;
    height: 34px;
    border: 1px solid var(--gold);
    color: var(--gold);
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--font-display);
  }
  .mark svg {
    width: 60%;
    height: 60%;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  nav ul {
    display: flex;
    gap: clamp(0.4rem, 2vw, 1.6rem);
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  nav a {
    text-decoration: none;
    font-size: 0.92rem;
    color: var(--text-2);
    padding: 0.4rem 0.2rem;
  }
  nav a[aria-current="page"],
  nav a:hover {
    color: var(--text);
  }
  nav a[aria-current="page"] {
    box-shadow: inset 0 -1px 0 var(--gold);
  }
  .cta {
    color: var(--gold-ink) !important;
    background: var(--gold);
    border-radius: 999px;
    padding: 0.5rem 1rem !important;
    font-weight: 500;
  }
  .menu-btn {
    display: none;
  }
  /* Phones: a Menu button opens the full list, so nothing runs off the screen. */
  @media (max-width: 720px) {
    .bar {
      height: 60px;
    }
    .menu-btn {
      display: block;
      font: inherit;
      font-size: 0.9rem;
      padding: 0.45rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      background: rgba(11, 10, 14, 0.5);
      color: var(--text);
      cursor: pointer;
    }
    nav {
      display: none;
      position: absolute;
      top: calc(60px + env(safe-area-inset-top));
      left: 0;
      right: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: rgba(11, 10, 14, 0.97);
      border-bottom: 1px solid var(--line);
    }
    :global(.menu-open) nav {
      display: block;
    }
    :global(.menu-open)::before {
      opacity: 1 !important;
    }
    nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    nav li {
      border-bottom: 1px solid var(--line);
    }
    nav a {
      display: block;
      font-size: 1.1rem;
      padding: 0.95rem 0.2rem;
    }
    nav a[aria-current="page"] {
      box-shadow: none;
      color: var(--gold);
    }
    nav li:last-child {
      border-bottom: 0;
      padding-top: 1rem;
    }
    .cta {
      display: inline-block;
    }
  }
</style>
