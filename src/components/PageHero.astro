---
// Header for inner pages: a photo (local or remote), a title and an answer-first intro.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: ImageMetadata;
  remoteImage?: { src: string; srcset?: string };
  position?: string;
  crumbs?: { name: string; path: string }[];
  compact?: boolean;
}
const { eyebrow, title, intro, image, remoteImage, position = "center", crumbs = [], compact = false } = Astro.props;
---

<header class:list={["page-hero grain", { compact }]}>
  {
    image && (
      <Image src={image} alt="" widths={[640, 1280, 1920, 2560]} sizes="100vw" class="bg drift" style={`object-position:${position}`} loading="eager" fetchpriority="high" format="avif" />
    )
  }
  {remoteImage && <img src={remoteImage.src} srcset={remoteImage.srcset} sizes="100vw" alt="" class="bg drift" style={`object-position:${position}`} fetchpriority="high" />}
  <div class="wrap inner">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    min-height: 68svh;
    display: flex;
    align-items: flex-end;
    padding: 8rem 0 3.5rem;
    overflow: hidden;
    isolation: isolate;
  }
  .compact {
    min-height: 46svh;
  }
  .bg {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    z-index: -2;
  }
  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--ink) 0%, rgba(11, 10, 14, 0.55) 45%, rgba(11, 10, 14, 0.45) 100%);
  }
  .inner {
    position: relative;
  }
  h1 {
    max-width: 18ch;
  }
  .lede {
    color: var(--text);
    opacity: 0.88;
  }
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0 0 1.25rem;
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 0.4rem;
    color: var(--text-3);
  }
  .crumbs a {
    text-decoration: none;
  }
</style>
