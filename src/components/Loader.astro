---
// The loader: black, one small star at the centre and a line of words under it. It is plain inline HTML, CSS
// and a few lines of script, so it paints before anything else on the page. The words move on a quarter of
// the way at a time as the page reports how much is in (window.__loader.progress(0..1)), ending on "What's
// next is in your hands". When everything is in (window.__loader.done()), the star bursts into many stars
// that fly out and fade over the landing page.
---

<div class="loader" id="loader" role="status" aria-live="polite">
  <div class="loader-bg"></div>
  <canvas class="loader-burst" aria-hidden="true"></canvas>
  <i class="loader-star" aria-hidden="true"></i>
  <p class="loader-text"><span class="loader-line">Loading hopes</span><span class="loader-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span></p>
</div>
<noscript><style>.loader{display:none!important}html.loading{overflow:auto!important}</style></noscript>

<style is:inline>
  /* Only the page itself: locking <body> too would make it its own scroll box, which pins the sticky 3D
     view to the top of the page, off screen when a reload restores a scroll position further down. */
  html.loading {
    overflow: hidden;
  }
  .loader {
    position: fixed;
    inset: 0;
    z-index: 2147483000;
    display: grid;
    place-items: center;
    pointer-events: auto;
  }
  .loader.out {
    pointer-events: none;
  }
  .loader-bg {
    position: absolute;
    inset: 0;
    background: #000;
    transition: opacity 1.1s ease 0.25s;
  }
  .loader.out .loader-bg {
    opacity: 0;
  }
  .loader-burst {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .loader-star {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 6px 2px rgba(255, 255, 255, 0.9),
      0 0 18px 6px rgba(190, 210, 255, 0.35),
      0 0 40px 14px rgba(150, 170, 255, 0.12);
    animation: loader-pulse 2.4s ease-in-out infinite;
  }
  /* Thin rays, like a star seen through a lens */
  .loader-star::before,
  .loader-star::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
    transform: translate(-50%, -50%);
  }
  .loader-star::before {
    width: 34px;
    height: 1px;
  }
  .loader-star::after {
    width: 1px;
    height: 34px;
    background: linear-gradient(transparent, rgba(255, 255, 255, 0.7), transparent);
  }
  .loader.out .loader-star {
    animation: loader-flash 0.35s ease-out forwards;
  }
  .loader-text {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + 2.4rem);
    margin: 0;
    text-align: center;
    font: 500 0.72rem/1 system-ui, -apple-system, "Segoe UI", sans-serif;
    letter-spacing: 0.32em;
    text-indent: 0.32em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    padding: 0 1.5rem;
    transition: opacity 0.25s ease;
  }
  .loader-line {
    display: inline-block;
    transition: opacity 0.28s ease, transform 0.28s ease, filter 0.28s ease;
  }
  .loader-line.swap {
    opacity: 0;
    transform: translateY(-5px);
    filter: blur(2px);
  }
  /* The dots fill in one by one, then empty, on a loop */
  .loader-dots span {
    display: inline-block;
    animation: loader-dot 1.4s infinite;
  }
  .loader-dots span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .loader-dots span:nth-child(3) {
    animation-delay: 0.4s;
  }
  .loader.out .loader-text {
    opacity: 0;
  }
  @keyframes loader-dot {
    0%, 15% { opacity: 0; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-3px); }
    42%, 70% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(0); }
  }
  @keyframes loader-pulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50% { transform: scale(1.35); opacity: 1; }
  }
  @keyframes loader-flash {
    0% { transform: scale(1); opacity: 1; }
    40% { transform: scale(3.2); opacity: 1; }
    100% { transform: scale(0.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .loader-star,
    .loader-dots span {
      animation: none;
    }
    .loader-line {
      transition: none;
    }
    .loader-bg {
      transition-duration: 0.4s;
    }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById("loader");
    if (!el) return;
    document.documentElement.classList.add("loading");
    // A quarter of the load each: hopes, dreams, the passion, then it's over to you. Each line stays up
    // long enough to read, so a fast load still steps through them rather than flickering.
    var LINES = ["Loading hopes", "Loading dreams", "Building the passion", "What’s next is in your hands"];
    var HOLD = 1300; // ms each line stays up, at the least
    var lineEl = el.querySelector(".loader-line");
    var shown = 0, want = 0, swappedAt = performance.now(), finished = false, burstAt = 0;
    function swapTo(i) {
      shown = i;
      swappedAt = performance.now();
      lineEl.classList.add("swap");
      setTimeout(function () {
        lineEl.textContent = LINES[i];
        lineEl.classList.remove("swap");
      }, 260);
    }
    var ticker = setInterval(function () {
      var now = performance.now();
      // every line gets its full time to be read, even when everything is already in
      if (want > shown && now - swappedAt >= HOLD) swapTo(shown + 1);
      if (finished && !burstAt && shown === LINES.length - 1) burstAt = Math.max(now, swappedAt + HOLD + 200);
      if (burstAt && now >= burstAt) {
        clearInterval(ticker);
        burst();
      }
    }, 60);
    function progress(p) {
      want = Math.max(want, Math.min(LINES.length - 1, Math.floor(p * LINES.length)));
    }
    // Everything is in: step on to the last line, give it a moment to be read, then burst.
    function done() {
      if (finished) return;
      finished = true;
      want = LINES.length - 1;
    }
    function burst() {
      var calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      el.classList.add("out");
      el.setAttribute("aria-busy", "false");
      document.documentElement.classList.remove("loading");
      var end = function () {
        el.remove();
      };
      if (calm) return void setTimeout(end, 600);
      // The burst: stars fly out from the centre, slowing as they go, twinkle, then fade.
      var cv = el.querySelector("canvas");
      var g = cv.getContext("2d");
      var dpr = Math.min(devicePixelRatio || 1, 2);
      var w = innerWidth, h = innerHeight;
      cv.width = w * dpr;
      cv.height = h * dpr;
      g.scale(dpr, dpr);
      var reach = Math.hypot(w, h) * 0.55;
      var n = Math.min(w, h) < 700 ? 150 : 260;
      var tints = ["255,255,255", "255,255,255", "255,255,255", "214,226,255", "255,226,180"];
      var stars = [];
      for (var i = 0; i < n; i++) {
        stars.push({
          a: Math.random() * Math.PI * 2,
          d: reach * (0.08 + 0.92 * Math.pow(Math.random(), 0.7)),
          r: 0.4 + Math.pow(Math.random(), 3) * 1.8,
          c: tints[(Math.random() * tints.length) | 0],
          tw: Math.random() * Math.PI * 2,
          life: 0.75 + Math.random() * 0.25,
        });
      }
      var T = 2100, t0 = performance.now();
      (function draw(now) {
        var t = Math.min(1, (now - t0) / T);
        g.clearRect(0, 0, w, h);
        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          var k = Math.min(1, t / s.life);
          var e = 1 - Math.pow(1 - k, 3);
          var x = w / 2 + Math.cos(s.a) * s.d * e;
          var y = h / 2 + Math.sin(s.a) * s.d * e;
          var fade = k < 0.06 ? k / 0.06 : k > 0.45 ? Math.max(0, 1 - (k - 0.45) / 0.55) : 1;
          var tw = 0.7 + 0.3 * Math.sin(s.tw + now * 0.02);
          g.fillStyle = "rgba(" + s.c + "," + (fade * tw).toFixed(3) + ")";
          g.beginPath();
          g.arc(x, y, s.r, 0, 6.2832);
          g.fill();
          if (s.r > 1.2) {
            g.fillStyle = "rgba(" + s.c + "," + (fade * tw * 0.18).toFixed(3) + ")";
            g.beginPath();
            g.arc(x, y, s.r * 3, 0, 6.2832);
            g.fill();
          }
        }
        if (t < 1) requestAnimationFrame(draw);
        else end();
      })(t0);
    }
    window.__loader = { done: done, progress: progress };
    // Never trap the page: if nothing reports back, let it through anyway.
    setTimeout(done, 45000);
  })();
</script>
