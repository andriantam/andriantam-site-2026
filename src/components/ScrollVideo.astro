---
// Scroll-scrubbed video hero. Scroll position drives the playhead; the video never plays on its own.
// Method: all-keyframe encode (scripts/encode-hero.sh), sticky viewport inside a tall scroller,
// eased seeking each animation frame, text "beats" faded on progress ranges.
// The poster renders instantly (it's the LCP image); the video downloads after the page has loaded.
// Beats are children with data-beat, data-from / data-to (progress 0..1 where the beat is fully in / starts leaving)
// and optional data-align="center" | "right".
interface Props {
  desktop: { video: string; poster: string };
  mobile: { video: string; poster: string };
  height?: string; // scroll length, e.g. "320vh"
  label: string; // describes the footage for screen readers
}
const { desktop, mobile, height = "320vh", label } = Astro.props;
---

<section class="sv" style={`--sv-height:${height}`} data-scroll-video data-desktop={desktop.video} data-mobile={mobile.video}>
  <div class="sv-sticky grain">
    <picture>
      <source media="(orientation: portrait)" srcset={mobile.poster} />
      <img class="sv-poster" src={desktop.poster} alt="" fetchpriority="high" decoding="async" />
    </picture>
    <video class="sv-video" muted playsinline preload="none" aria-label={label} tabindex="-1"></video>
    <div class="sv-scrim" aria-hidden="true"></div>
    <div class="sv-beats">
      <slot />
    </div>
    <div class="sv-hud" aria-hidden="true">
      <span class="sv-load"><span class="sv-load-bar"></span></span>
      <span class="sv-hint">Scroll</span>
    </div>
  </div>
</section>

<style>
  .sv {
    position: relative;
    height: var(--sv-height);
  }
  .sv-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: var(--ink);
  }
  .sv-poster,
  .sv-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sv-video {
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .sv.is-ready .sv-video {
    opacity: 1;
  }
  .sv-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(11, 10, 14, 0.55) 0%, rgba(11, 10, 14, 0) 30%),
      linear-gradient(to top, rgba(11, 10, 14, 0.85) 0%, rgba(11, 10, 14, 0) 55%),
      radial-gradient(ellipse at 30% 60%, rgba(11, 10, 14, 0.35), transparent 60%);
  }
  .sv-beats {
    position: absolute;
    inset: 0;
  }
  .sv-beats :global([data-beat]) {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(5rem, 14vh, 9rem);
    max-width: 780px;
    opacity: 0;
    transform: translateY(24px);
    will-change: opacity, transform;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }
  .sv-beats :global([data-beat][data-align="center"]) {
    left: 50%;
    right: auto;
    width: min(780px, calc(100% - 2 * var(--gutter)));
    transform: translate(-50%, 24px);
    text-align: center;
  }
  .sv-beats :global([data-beat][data-align="right"]) {
    left: auto;
    text-align: right;
  }
  .sv-hud {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .sv-load {
    width: 120px;
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .sv-load-bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gold);
    transition: width 0.2s linear;
  }
  .sv.is-ready .sv-load {
    opacity: 0;
    transition: opacity 0.6s;
  }
  .sv-hint {
    animation: bob 2.4s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv {
      height: auto;
    }
    .sv-video,
    .sv-hud {
      display: none;
    }
    .sv-beats :global([data-beat]) {
      position: relative;
      opacity: 1 !important;
      transform: none !important;
      left: auto;
      bottom: auto;
    }
    .sv-beats {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 6rem var(--gutter) 4rem;
      gap: 2rem;
    }
  }
</style>

<script>
  const FADE = 0.05; // absolute fade width in progress space
  const EASE = 0.12;

  for (const root of document.querySelectorAll<HTMLElement>("[data-scroll-video]")) init(root);

  function init(root: HTMLElement) {
    const video = root.querySelector<HTMLVideoElement>(".sv-video")!;
    const bar = root.querySelector<HTMLElement>(".sv-load-bar")!;
    const hud = root.querySelector<HTMLElement>(".sv-hud")!;
    const beats = [...root.querySelectorAll<HTMLElement>("[data-beat]")].map((el) => ({
      el,
      from: Number(el.dataset.from ?? 0),
      to: Number(el.dataset.to ?? 1),
      center: el.dataset.align === "center",
    }));
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Measure once; re-measure only on width change or a big height change
    // (mobile URL bars collapsing must not remap the timeline mid-scroll).
    let span = 1;
    let lastW = 0;
    let lastH = 0;
    const measure = () => {
      span = Math.max(1, root.offsetHeight - innerHeight);
      lastW = innerWidth;
      lastH = innerHeight;
    };
    measure();
    addEventListener("resize", () => {
      if (innerWidth !== lastW || Math.abs(innerHeight - lastH) > 140) measure();
    });

    const progress = () => Math.min(1, Math.max(0, -root.getBoundingClientRect().top / span));

    let ready = false;
    let current = 0;
    let lastSeek = -1;
    let visible = true;

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);

    const opacityFor = (p: number, b: { from: number; to: number }) => {
      if (p < b.from - FADE || p > b.to + FADE) return 0;
      if (p < b.from) return (p - (b.from - FADE)) / FADE;
      if (p > b.to) return 1 - (p - b.to) / FADE;
      return 1;
    };

    const frame = () => {
      if (visible) {
        const p = progress();
        hud.style.opacity = String(Math.max(0, 1 - p * 4));
        for (const b of beats) {
          const o = opacityFor(p, b);
          b.el.style.opacity = o.toFixed(3);
          const y = (1 - o) * 24 * (p < b.from ? 1 : -1);
          b.el.style.transform = b.center ? `translate(-50%, ${y}px)` : `translateY(${y}px)`;
          b.el.style.pointerEvents = o > 0.5 ? "auto" : "none";
        }
        if (ready && video.duration) {
          const target = p * (video.duration - 0.05);
          current += reduced ? target - current : (target - current) * EASE;
          if (Math.abs(current - lastSeek) > 0.005) {
            video.currentTime = current;
            lastSeek = current;
          }
        }
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    if (reduced) return;

    // iOS keeps a video locked until a user gesture touches it.
    const unlock = () => {
      video.play().then(() => video.pause()).catch(() => {});
      removeEventListener("touchstart", unlock);
      removeEventListener("pointerdown", unlock);
    };
    addEventListener("touchstart", unlock, { passive: true });
    addEventListener("pointerdown", unlock);

    // Download the whole file to a Blob after the page has loaded, so nothing buffers mid-scrub.
    const src = matchMedia("(orientation: portrait)").matches ? root.dataset.mobile! : root.dataset.desktop!;
    const start = async () => {
      try {
        const res = await fetch(src);
        if (!res.ok || !res.body) throw new Error(String(res.status));
        const total = Number(res.headers.get("content-length")) || 0;
        const reader = res.body.getReader();
        const chunks: Uint8Array[] = [];
        let got = 0;
        for (;;) {
          const { done, value } = await reader.read();
          if (done) break;
          chunks.push(value);
          got += value.length;
          if (total) bar.style.width = `${Math.round((got / total) * 100)}%`;
        }
        video.src = URL.createObjectURL(new Blob(chunks as BlobPart[], { type: "video/mp4" }));
      } catch {
        video.src = src; // fall back to streaming
      }
      video.addEventListener(
        "loadeddata",
        () => {
          bar.style.width = "100%";
          ready = true;
          current = progress() * video.duration;
          root.classList.add("is-ready");
        },
        { once: true },
      );
      video.load();
    };
    const conn = (navigator as any).connection;
    if (conn?.saveData) return; // respect data saver: keep the poster
    if (document.readyState === "complete") setTimeout(start, 150);
    else addEventListener("load", () => setTimeout(start, 150), { once: true });
  }
</script>
