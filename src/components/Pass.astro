<script>
  import type { PassApi } from "../scripts/pass/scene";

  const root = document.querySelector<HTMLElement>("[data-pass]");
  if (root) {
    const chapters = [...root.querySelectorAll<HTMLElement>("[data-ch]")];
    const view = root.querySelector<HTMLElement>(".view")!;
    const stops = [...root.querySelectorAll<HTMLButtonElement>("[data-stop]")];
    const data = JSON.parse(document.getElementById("pass-data")!.textContent!);
    const cards = JSON.parse(document.getElementById("pass-cards")!.textContent!);
    let api: PassApi | null = null;
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    let fallback = false;

    // Chapter text fades in as it arrives.
    const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle("on", e.isIntersecting)), {
      rootMargin: "-22% 0px -22% 0px",
    });
    chapters.forEach((c) => io.observe(c));

    // Progress: which section the middle of the screen is on, as a fraction (0 = title, last = contact).
    let centers: number[] = [];
    const measure = () => {
      centers = chapters.map((c) => c.getBoundingClientRect().top + scrollY + c.offsetHeight / 2);
    };
    const progress = () => {
      const y = scrollY + innerHeight / 2;
      if (y <= centers[0]) return 0;
      for (let i = 1; i < centers.length; i++) {
        if (y < centers[i]) return i - 1 + (y - centers[i - 1]) / (centers[i] - centers[i - 1]);
      }
      return centers.length - 1;
    };
    // Ticker stops: 0 is the sky (both sky pages), then one per chapter, then contact.
    const finale = root.querySelector<HTMLElement>(".finale")!;
    const stopOf = (f: number) => Math.max(0, Math.min(stops.length - 1, Math.round(f)));
    let current = -1, ready = false, byButton = false;
    const engine = document.querySelector<HTMLButtonElement>("[data-engine-btn]")!;
    const update = () => {
      const f = progress();
      api?.setProgress(f);
      root.style.setProperty("--tint", String(Math.max(0, 1 - f / 0.55).toFixed(3)));
      document.documentElement.classList.toggle("at-sky", f < 0.45);
      grow();
      finale.classList.toggle("ready", f > centers.length - 1.22 || !api);
      engine.classList.toggle("on", !!api && ready && (f > 0.9 || root.classList.contains("driving")));
      const s = stopOf(f);
      if (fallback) slides.forEach((el, i) => el.classList.toggle("on", i + 1 === s));
      if (s !== current) {
        current = s;
        stops.forEach((b, i) => (i === s ? b.setAttribute("aria-current", "step") : b.removeAttribute("aria-current")));
      }
    };
    // The header's wordmark grows out of the corner into the middle of the sky as you scroll from contact
    // to the footer, following the scroll both ways. Large screens only: on phones and tablets the footer
    // fills the screen and the big wordmark would sit on top of its text.
    const roomy = matchMedia("(min-width: 900px) and (min-height: 600px)");
    const brand = document.querySelector<HTMLElement>(".site-header .brand");
    let home: DOMRect | null = null;
    const grow = () => {
      if (!brand) return;
      if (!home) {
        brand.style.transform = "";
        home = brand.getBoundingClientRect();
      }
      const start = centers[centers.length - 1] - innerHeight / 2; // contact in place
      const end = document.documentElement.scrollHeight - innerHeight; // the very end
      const raw = Math.min(1, Math.max(0, (scrollY - start - (end - start) * 0.25) / ((end - start) * 0.75)));
      const t = raw * raw * (3 - 2 * raw);
      if (t <= 0 || !roomy.matches || root.classList.contains("driving")) {
        brand.style.transform = "";
        brand.style.filter = "";
        return;
      }
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const width = Math.min(innerWidth * 0.78, 44 * rem);
      const top = Math.min(Math.max(5.5 * rem, innerHeight * 0.18), 11 * rem);
      const k = 1 + (width / home.width - 1) * t;
      const dx = ((innerWidth - width) / 2 - home.left) * t;
      const dy = (top - home.top) * t;
      brand.style.transformOrigin = "0 0";
      brand.style.transform = `translate(${dx.toFixed(1)}px,${dy.toFixed(1)}px) scale(${k.toFixed(4)})`;
      brand.style.filter = `drop-shadow(0 2px ${(14 / k).toFixed(1)}px rgba(3, 4, 9, ${(0.9 * t).toFixed(2)}))`;
    };
    // Mouse wheel, trackpad and keyboard. A wheel click, a trackpad flick or a key moves exactly one section
    // and stops there; the momentum that follows a flick is swallowed so it can't carry you further.
    // A slow trackpad drag moves the page (and the car) by hand instead, but never past the next section:
    // it stops there until you start a new gesture. The pause after each move always ends by itself after
    // a fixed time, so scrolling can never get stuck waiting for a click.
    const restingPoints = () => [...centers.map((c) => c - innerHeight / 2), document.documentElement.scrollHeight - innerHeight];
    let pausedUntil = 0, lastWheelAt = 0, lastAbs = 0;
    let gesture: { mode: "step"; done: boolean } | { mode: "drag"; lo: number; hi: number } | null = null;
    const FLICK = 40; // px in one event: a wheel click, or the start of a flick
    const step = (dir: 1 | -1) => {
      const pts = restingPoints();
      const y = scrollY;
      const target = dir > 0 ? pts.find((p) => p > y + 4) : [...pts].reverse().find((p) => p < y - 4);
      if (target === undefined) return;
      scrollTo({ top: target, behavior: "smooth" });
      pausedUntil = performance.now() + 650;
    };
    const touchOnly = matchMedia("(hover: none)").matches;
    if (!touchOnly) {
      addEventListener(
        "wheel",
        (e) => {
          if (root.classList.contains("driving")) return void e.preventDefault(); // the page stays put while you drive
          if (e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return; // pinch zoom, sideways scrolls
          e.preventDefault();
          const now = performance.now();
          const px = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * innerHeight : e.deltaY;
          const abs = Math.abs(px), dir = px > 0 ? 1 : -1;
          const newGesture = now - lastWheelAt > 180;
          const surge = abs >= FLICK && abs > lastAbs * 1.5 + 2; // a flick that starts without a pause
          lastWheelAt = now;
          lastAbs = abs;
          if (newGesture || !gesture || surge) {
            if (abs >= FLICK || e.deltaMode !== 0) gesture = { mode: "step", done: false };
            else {
              const pts = restingPoints(), y = scrollY;
              const lo = [...pts].reverse().find((p) => p < y - 4) ?? 0;
              const hi = pts.find((p) => p > y + 4) ?? pts[pts.length - 1];
              gesture = { mode: "drag", lo, hi };
            }
          }
          if (now < pausedUntil) return;
          if (gesture.mode === "step") {
            if (!gesture.done) {
              gesture.done = true;
              step(dir);
            }
            return;
          }
          scrollTo({ top: Math.min(gesture.hi, Math.max(gesture.lo, scrollY + px)), behavior: "instant" });
        },
        { passive: false },
      );
      addEventListener("keydown", (e) => {
        const t = e.target as HTMLElement;
        if (e.altKey || e.ctrlKey || e.metaKey || t.closest("input, textarea, select, [contenteditable]")) return;
        if (root.classList.contains("driving")) return;
        const dir = ["ArrowDown", "PageDown", " "].includes(e.key) ? (e.shiftKey && e.key === " " ? -1 : 1) : ["ArrowUp", "PageUp"].includes(e.key) ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        if (performance.now() >= pausedUntil) step(dir as 1 | -1);
      });
    }
    stops.forEach((b, i) =>
      b.addEventListener("click", () => {
        scrollTo({ top: centers[i] - innerHeight / 2, behavior: "smooth" });
      }),
    );
    measure();
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", () => ((home = null), measure(), update()));
    new ResizeObserver(() => (measure(), update())).observe(root);

    // The card for a selected star.
    const card = root.querySelector<HTMLElement>("[data-card]")!;
    const show = (id: string | null) => {
      const c = id ? cards[id] : null;
      card.hidden = !c;
      if (!c || !id) return;
      card.style.setProperty("--c", c.color);
      card.querySelector("[data-card-meta]")!.textContent = c.meta;
      card.querySelector("[data-card-title]")!.textContent = c.label;
      card.querySelector("[data-card-blurb]")!.textContent = c.blurb;
      const tags = card.querySelector<HTMLElement>("[data-card-tags]")!;
      tags.textContent = c.tags.join(" · ");
      tags.hidden = !c.tags.length;
      card.querySelector<HTMLAnchorElement>("[data-card-link]")!.href = `/atlas/${id}`;
      card.querySelector("[data-card-rel]")!.replaceChildren(
        ...c.related.map((r: { id: string; label: string }) => {
          const b = document.createElement("button");
          b.type = "button";
          b.textContent = r.label;
          b.addEventListener("click", () => (api?.select(r.id), show(r.id)));
          return b;
        }),
      );
      card.style.animation = "none";
      void card.offsetWidth;
      card.style.animation = "";
    };
    card.querySelector("[data-card-close]")!.addEventListener("click", () => (api?.select(null), show(null)));
    addEventListener("keydown", (e) => e.key === "Escape" && !card.hidden && (api?.select(null), show(null)));

    // Touch controls: the pedals and the Left and Right buttons
    const pad = root.querySelector<HTMLElement>("[data-pad]")!;
    const steerBox = root.querySelector<HTMLElement>("[data-steer]")!;
    const gauge = root.querySelector<HTMLElement>(".gauge")!;
    const gaugeHome = gauge.previousElementSibling!; // where it goes back to
    const pedalOn = { go: false, brake: false };
    const turnOn = { left: false, right: false };
    let steerVal = 0;
    const send = () => api?.setStick(steerVal, pedalOn.brake ? 1 : pedalOn.go ? -1 : 0);
    // Each pedal and steering button follows its own finger, so you can steer while on the throttle
    const hold = (el: HTMLElement, set: (on: boolean) => void) => {
      el.addEventListener("pointerdown", (e) => {
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        el.classList.add("held");
        set(true);
      });
      for (const t of ["pointerup", "pointercancel", "lostpointercapture"])
        el.addEventListener(t, () => {
          el.classList.remove("held");
          set(false);
        });
    };
    root.querySelectorAll<HTMLElement>("[data-pedal]").forEach((el) => {
      const which = el.dataset.pedal as "go" | "brake";
      hold(el, (on) => ((pedalOn[which] = on), send()));
    });
    // Left and Right: full lock while held (the car eases the wheel in, and less at speed); both at once, straight
    root.querySelectorAll<HTMLElement>("[data-turn]").forEach((el) => {
      const which = el.dataset.turn === "1" ? "right" : "left";
      hold(el, (on) => {
        turnOn[which] = on;
        steerVal = (turnOn.right ? 1 : 0) - (turnOn.left ? 1 : 0);
        send();
      });
    });
    // After a race. The pad stops iOS's own touch handling (so no click events), so act on the pointer itself.
    const afterAgain = root.querySelector<HTMLElement>('[data-after-slot="next"]')!;
    root.querySelectorAll<HTMLElement>("[data-after-act]").forEach((el) =>
      el.addEventListener("pointerup", () => api?.raceAction(el.dataset.afterAct as "again" | "up" | "free")),
    );
    pad.addEventListener("pointerdown", (e) => e.preventDefault());
    // iOS starts its text magnifier and selection from the touch itself, not the pointer: stop that here.
    // (Pointer events still arrive, so the pedals and buttons keep working.)
    pad.addEventListener("touchstart", (e) => e.cancelable && e.preventDefault(), { passive: false });
    pad.addEventListener("touchmove", (e) => e.cancelable && e.preventDefault(), { passive: false });
    pad.addEventListener("contextmenu", (e) => e.preventDefault());
    const stickUp = () => {
      pedalOn.go = pedalOn.brake = turnOn.left = turnOn.right = false;
      steerVal = 0;
      root.querySelectorAll("[data-pedal], [data-turn]").forEach((el) => el.classList.remove("held"));
      send();
    };

    // The loader stays up until everything is in: the page itself (images, fonts) and then either the whole
    // 3D scene (car, textures, shaders, a first frame) or, if the 3D can't run, the photos of the picture story.
    const loader = (window as Window & { __loader?: { done(): void; progress(p: number): void } }).__loader;
    const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
    const pageLoaded = new Promise<void>((r) => (document.readyState === "complete" ? r() : addEventListener("load", () => r(), { once: true })));
    let revealed = false;
    const reveal = async () => {
      if (revealed) return;
      revealed = true;
      await Promise.race([Promise.all([pageLoaded, document.fonts?.ready]), wait(8000)]);
      loader?.done();
    };
    // The picture story replaces the 3D. Never the 3D without its car.
    const useSlides = async (why: unknown) => {
      if (fallback || revealed) return;
      fallback = true;
      console.warn("3D unavailable, showing the picture story", why);
      api?.dispose();
      api = null;
      delete root.dataset.three;
      root.dataset.fallback = "";
      measure();
      update();
      const imgs = slides.map((s) => s.querySelector("img")!);
      imgs.forEach((i) => (i.loading = "eager"));
      let decoded = 0;
      const decodeOne = (i: HTMLImageElement) => i.decode().catch(() => {}).then(() => loader?.progress(++decoded / imgs.length));
      await Promise.race([Promise.all(imgs.map(decodeOne)), wait(12000)]);
      reveal();
    };

    // Only run the 3D where it will run well.
    const nav = navigator as Navigator & { deviceMemory?: number; connection?: { saveData?: boolean } };
    // The lite site (lite.andriantam.com, or ?lite to try it locally) and phones get the photo story by default,
    // with a button to load the 3D if you want it (remembered for the tab, or ?3d).
    const params = new URLSearchParams(location.search);
    const liteHost = location.hostname.startsWith("lite.");
    const phone = matchMedia("(max-width: 820px) and (pointer: coarse)").matches;
    let chose3d = params.has("3d");
    try {
      chose3d ||= sessionStorage.getItem("pass3d") === "1";
    } catch {}
    const liteByChoice = params.has("lite") || ((liteHost || phone) && !chose3d);
    const lite = liteByChoice;
    const otherSkip = matchMedia("(prefers-reduced-motion: reduce)").matches || (nav.deviceMemory ?? 8) <= 2 || nav.connection?.saveData;
    const skip = lite || otherSkip;
    const load3d = root.querySelector<HTMLButtonElement>("[data-load3d]");
    // On a phone in 3D, a way back to the lite version (clears the remembered choice and the ?3d)
    const liteBack = root.querySelector<HTMLButtonElement>("[data-liteback]");
    if (liteBack && (phone || liteHost) && !lite && !otherSkip) {
      liteBack.hidden = false;
      // Only on the opening sky: it goes once you scroll on into the story or drive
      const skyEl = root.querySelector<HTMLElement>("[data-sky]");
      if (skyEl) new IntersectionObserver(([e]) => liteBack.classList.toggle("away", !e.isIntersecting)).observe(skyEl);
      liteBack.addEventListener("click", () => {
        try {
          sessionStorage.removeItem("pass3d");
        } catch {}
        const url = new URL(location.href);
        url.searchParams.delete("3d");
        url.searchParams.delete("lite");
        location.replace(url.toString());
      });
    }
    if (load3d && liteByChoice && !otherSkip) {
      load3d.hidden = false;
      load3d.addEventListener("click", () => {
        try {
          sessionStorage.setItem("pass3d", "1");
        } catch {}
        const url = new URL(location.href);
        url.searchParams.delete("lite");
        url.searchParams.set("3d", "");
        location.replace(url.toString());
      });
    }
    const start = async () => {
      // A very slow connection gets the picture story rather than an endless wait.
      setTimeout(() => !revealed && useSlides("timed out"), 30000);
      try {
        const { initPass } = await import("../scripts/pass/scene");
        if (fallback) return;
        loader?.progress(0.25); // the 3D code is in: the first quarter; the scene's own loading is the rest
        api = initPass({
          onReady: () => {
            if (fallback) return;
            ready = true;
            update();
            reveal();
          },
          onFail: (e) => useSlides(e),
          onLoading: (p) => !fallback && loader?.progress(0.25 + p * 0.75),
          canvas: root.querySelector<HTMLCanvasElement>("[data-canvas]")!,
          labels: root.querySelector<HTMLElement>("[data-labels]")!,
          center: root.querySelector<HTMLElement>("[data-center]")!,
          pointer: root.querySelector<HTMLElement>("[data-sky]")!,
          ...data,
          onSelect: show,
          onRace: (e) => {
            const fmt = (t: number) => (t >= 60 ? `${Math.floor(t / 60)}:${(t % 60).toFixed(1).padStart(4, "0")}` : t.toFixed(1));
            const clock = root.querySelector<HTMLElement>("[data-race-clock]")!;
            const gates = root.querySelector<HTMLElement>("[data-race-gates]")!;
            const flash = root.querySelector<HTMLElement>("[data-race-flash]")!;
            const note = root.querySelector<HTMLElement>("[data-race-note]")!;
            const again = root.querySelector<HTMLElement>("[data-race-again]")!;
            const up = root.querySelector<HTMLElement>("[data-race-up]")!;
            const html = document.documentElement;
            const show = (text: string, kind: string, hideAfter = 0) => {
              flash.textContent = text;
              flash.className = `race-flash on ${kind}`;
              clearTimeout(Number(flash.dataset.timer));
              if (hideAfter) flash.dataset.timer = String(window.setTimeout(() => flash.classList.remove("on"), hideAfter));
            };
            if (e.type === "reset") {
              clock.textContent = gates.textContent = note.textContent = again.textContent = up.textContent = "";
              html.classList.remove("race-done", "race-failed");
              clock.classList.remove("low");
              flash.className = "race-flash";
            } else if (e.type === "go") {
              show("GO!", "go", 1100);
              clock.textContent = fmt(e.left);
              gates.textContent = `Gate 1 of ${e.gates}`;
            } else if (e.type === "tick") {
              clock.textContent = fmt(e.left);
              clock.classList.toggle("low", e.left < 5);
              gates.textContent = e.gate < e.gates ? `Gate ${e.gate + 1} of ${e.gates}` : "Finish";
            } else if (e.type === "gate") {
              show(`+${e.added.toFixed(1)}`, "plus", 900);
            } else if (e.type === "fail") {
              clock.textContent = "0.0";
              show("FAILED", "fail");
              again.textContent = "Press R to restart";
              afterAgain.dataset.label = "Try again";
              afterAgain.dataset.afterAct = "again";
              html.classList.add("race-failed");
            } else if (e.type === "finish") {
              clock.classList.remove("low");
              clock.textContent = gates.textContent = ""; // the time is in the message below
              show("FINISHED", "done");
              note.innerHTML = `${e.dir === "up" ? "Hill climb" : "Toge run"} completed in <b>${e.total.toFixed(2)} seconds</b>`;
              again.textContent = "Press R to race again";
              up.textContent = e.dir === "up" ? "Press U to climb again" : "Press U for the uphill climb";
              afterAgain.dataset.label = e.dir === "up" ? "Climb again" : "Uphill challenge";
              afterAgain.dataset.afterAct = "up";
              html.classList.add("race-done");
            }
          },
          onGauge: (kmh, gear) => {
            root.querySelector<HTMLElement>("[data-kmh]")!.textContent = String(kmh);
            root.querySelector<HTMLElement>("[data-gear]")!.textContent = gear;
          },
          onSound: (st) => {
            const el = root.querySelector<HTMLElement>("[data-sound]")!;
            const m = touchOnly ? "" : " · M";
            el.textContent = st === "on" ? `Sound on${m}` : st === "off" ? `Sound off${m}` : st === "blocked" ? "Sound blocked by the browser" : "Sound unavailable";
            el.classList.toggle("warn", st === "blocked" || st === "unavailable");
          },
          onDrive: (on, stop) => {
            root.classList.toggle("driving", on);
            document.documentElement.classList.toggle("driving", on);
            const touchDrive = on && byButton;
            document.documentElement.classList.toggle("touch-drive", touchDrive); // keys need no touch controls
            // The speed, gear and sound sit with the steering buttons on a touch screen, and go back after
            if (touchDrive) steerBox.prepend(gauge);
            else if (gauge.parentElement === steerBox) gaugeHome.after(gauge);
            byButton = false;
            engine.setAttribute("aria-pressed", String(on));
            engine.setAttribute("aria-label", on ? "Stop the engine and go back to the story" : "Start the engine and drive");
            if (!on) {
              // Back to the story at the part nearest where you left the car: that chapter, or contact in the car park
              stickUp();
              const i = Math.max(1, Math.min(centers.length - 1, stop));
              scrollTo({ top: centers[i] - innerHeight / 2, behavior: "instant" });
            }
            update();
            grow(); // the wordmark goes back to its place in the header while you drive
          },
        });
        update();
        new IntersectionObserver(([e]) => api?.setActive(e.isIntersecting)).observe(view);
        // The engine button: drive from here, or stop and go back to the story. A touch screen gets pedals and steering.
        engine.addEventListener("click", () => {
          if (!api) return;
          const on = !root.classList.contains("driving");
          byButton = on && (touchOnly || matchMedia("(pointer: coarse)").matches);
          api.drive(on);
          engine.blur(); // so Space is the handbrake, not another press of the button
        });
        if (!fallback) root.dataset.three = "";
      } catch (err) {
        useSlides(err);
      }
    };
    if (skip) useSlides("reduced motion, low memory or data saver");
    else start();
  }
</script>
