---
// The home page. It opens on the night sky: my name at the centre, every star around it something I do. Scrolling brings the camera
// down to the car and the story becomes a drive up a mountain pass, ending with a handbrake turn in a car park
// and the contact details. The 3D scene sits behind ordinary HTML: every word here is in the page before any 3D
// loads, and the page still reads without it.
import { Image } from "astro:assets";
import { SITE } from "../config/site";
import Footer from "./Footer.astro";
import Loader from "./Loader.astro";
import mountains from "../assets/photos/mountains.jpg";
import shooting from "../assets/photos/product-header.jpg";
import laptop from "../assets/photos/laptop.jpg";
import mckTeam from "../assets/photos/mckinsey-team.jpg";
import automotive from "../assets/photos/automotive-header.jpg";
import walking from "../assets/photos/hero-bg.jpg";
import me from "../assets/photos/me.jpg";
import "@fontsource/russo-one/latin-400.css";
import { CLUSTERS, NODES, EDGES, KIND_LABELS, related, depth } from "../data/graph";

const CHAPTERS = [
  {
    id: "camera",
    year: "2010",
    eyebrow: "2010 · High school",
    title: ["It started with a ", "camera."],
    body: "I spent hours in bookshops studying how each photo was made, and shot on borrowed DSLRs until my brother bought me my first: a Canon 500D.",
  },
  {
    id: "uni",
    year: "2012",
    eyebrow: "2012 to 2015 · University",
    title: ["I learned how people ", "see."],
    body: "Cognitive Science at UNIMAS: AI, neural networks and perception. Between lectures I photographed everything.",
  },
  {
    id: "agency",
    year: "2015",
    eyebrow: "2015 to 2017 · Ad agency",
    title: ["Then I built what people ", "touch."],
    body: "A software engineer who fell for UI/UX. At Isobar I built interactive campaigns, one of which won three Silvers.",
  },
  {
    id: "mckinsey",
    year: "2018",
    eyebrow: "2018 to 2024 · McKinsey & Company",
    title: ["The stakes got ", "serious."],
    body: "Six years building for banks and industry. I led 15 engineers on a bank's app that launched as the lockdown hit.",
  },
  {
    id: "toge",
    year: "2024",
    eyebrow: "2024 · Toge",
    title: ["The hobby became the ", "business."],
    body: "Official media for Autoshow Malaysia, Super GT Sepang and Tokyo Auto Salon KL. But when every frame was for money, the creativity went. So I made photography a passion again.",
  },
  {
    id: "brand",
    year: "2026",
    eyebrow: "2025 to now · Back in a team",
    title: ["Still hands-on, still ", "building."],
    body: "Head of Brand at TROOPERS Singapore, and I build the tech behind it: a customer data platform, and AI video editing that turned three days into three hours.",
  },
];
// The picture story, used when the 3D can't run: one photo per chapter, then contact. They stay unloaded
// (display: none) unless it's needed.
const SLIDES = [
  { src: mountains, pos: "50% 50%" },
  { src: shooting, pos: "30% 40%" }, // 2012: between lectures I photographed everything
  { src: laptop, pos: "50% 50%" },
  { src: mckTeam, pos: "28% 62%" },
  { src: automotive, pos: "50% 50%" },
  { src: walking, pos: "40% 40%" },
  { src: me, pos: "50% 10%" },
];
// The ticker down the right-hand side: the sky, one stop per chapter, then contact.
const STOPS = ["Sky", ...CHAPTERS.map((c) => c.year), "Contact"];

const passData = {
  nodes: NODES.map((n) => ({ id: n.id, label: n.label, cluster: n.cluster, hub: !!n.hub, parent: n.parent ?? null, level: depth(n) })),
  edges: EDGES,
  clusters: CLUSTERS.map((c) => ({ id: c.id, color: c.color })),
  years: CHAPTERS.map((c) => c.year),
};
const cards = Object.fromEntries(
  NODES.map((n) => [
    n.id,
    {
      label: n.label,
      meta: [CLUSTERS.find((c) => c.id === n.cluster)!.label, KIND_LABELS[n.kind], n.when].filter(Boolean).join(" · "),
      blurb: n.blurb,
      color: CLUSTERS.find((c) => c.id === n.cluster)!.color,
      tags: n.tags ?? [],
      related: related(n.id).map((r) => ({ id: r.id, label: r.label })),
    },
  ]),
);
---

<Loader />
<section class="pass" data-pass aria-label="My story">
  <div class="view">
    <picture aria-hidden="true">
      <source srcset="/media/hero-poster-540.webp" media="(orientation: portrait)" width="540" height="960" />
      <img class="still" src="/media/hero-poster-1280.webp" alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
    </picture>
    <div class="slides" aria-hidden="true">
      {
        SLIDES.map((s, i) => (
          <div class="slide" data-slide={i + 1}>
            <Image src={s.src} alt="" widths={[640, 1280, 1920]} sizes="100vw" loading="lazy" format="avif" style={`object-position:${s.pos}`} />
          </div>
        ))
      }
    </div>
    <canvas data-canvas aria-hidden="true"></canvas>
    <div class="tint" aria-hidden="true"></div>
    <div class="labels" data-labels aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="race" data-race aria-live="polite">
      <p class="race-clock" data-race-clock></p>
      <p class="race-gates" data-race-gates></p>
      <p class="race-flash" data-race-flash></p>
      <p class="race-note" data-race-note></p>
      <p class="race-again" data-race-again></p>
      <p class="race-again race-up" data-race-up></p>
    </div>
    <p class="gauge" aria-hidden="true"><b data-kmh>0</b><span>km/h</span><i data-gear>1</i><em data-sound></em></p>
    <p class="drive-hint mouse-only" aria-live="polite">W A S D to drive · Space for the handbrake · C to change camera · M for sound · Esc to stop</p>
    <!-- Touch driving: pedals at the bottom left (hold the brake once stopped to reverse), Left and Right at the bottom right -->
    <div class="pad" data-pad aria-hidden="true">
      <div class="pedals">
        <div class="pedal go" data-pedal="go"><span data-label="Accelerate"></span></div>
        <div class="pedal brake" data-pedal="brake"><span data-label="Brake"></span></div>
      </div>
      <!-- After a race: what next (labels set by the script, drawn by CSS so iOS has no text to magnify) -->
      <div class="after" data-after>
        <button type="button" class="after-btn" data-after-slot="free" data-after-act="free" data-label="Drive freely"></button>
        <button type="button" class="after-btn primary" data-after-slot="next" data-after-act="up" data-label="Uphill challenge"></button>
      </div>
      <div class="steer" data-steer>
        <div class="turn" data-turn="-1"><i></i><span data-label="Left"></span></div>
        <div class="turn right" data-turn="1"><i></i><span data-label="Right"></span></div>
      </div>
    </div>
    <nav class="rail" aria-label="Progress">
      <ol>
        {
          STOPS.map((s, i) => (
            <li>
              <button type="button" data-stop={i} aria-label={s}>
                <span>{s}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <!-- Take the wheel wherever the car is; press again to stop and go back to the story -->
  <button type="button" class="engine" data-engine-btn aria-label="Start the engine and drive" aria-pressed="false">
    <span class="face"><i class="led"></i>ENGINE<br />START<br />STOP</span>
  </button>

  <div class="flow">
    <!-- The sky: the name at the centre of the map, the stars around it -->
    <header class="ch sky" id="atlas" data-ch data-sky>
      <i class="snap" aria-hidden="true"></i>
      <h1 class="me" data-center>
        <img class="wordmark" src="/wordmark.png" alt="andriantam" width="2400" height="196" />
        <span class="who">{SITE.person} · {SITE.roles.join(" · ")}</span>
      </h1>
      <aside class="card" data-card hidden aria-live="polite">
        <button type="button" class="close" data-card-close aria-label="Close">✕</button>
        <p class="meta" data-card-meta></p>
        <h3 data-card-title></h3>
        <p class="blurb" data-card-blurb></p>
        <p class="tags" data-card-tags></p>
        <div class="rel" data-card-rel></div>
        <a class="btn btn-primary" data-card-link href="/atlas">Open its page →</a>
      </aside>
      <p class="hint">
        <span class="three-only"><span class="touch-only">Tap a star · Drag to look around</span><span class="mouse-only">Move to look around · Click a star</span> · <a href="/atlas">See it as a list</a></span>
        <span class="go" aria-hidden="true"><span class="touch-only">Swipe up</span><span class="mouse-only">Scroll</span><span class="three-only"> to start the drive</span><span class="slides-only"> for my story</span><i></i></span>
        <button type="button" class="load3d" data-load3d hidden>Load the 3D experience</button>
      </p>
      <!-- Phones in 3D: a small way back to lite, top left, out of the constellation's way -->
      <button type="button" class="liteback" data-liteback hidden>Lite version</button>
    </header>

    {
      CHAPTERS.map((c, i) => (
        <article class="ch story" data-ch aria-labelledby={`ch-${c.id}`}>
          <i class="snap" aria-hidden="true" />
          <div class="copy wrap">
            <div class="text">
              <p class="eyebrow">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                {c.eyebrow}
              </p>
              <h2 id={`ch-${c.id}`}>
                {c.title[0]}
                <em>{c.title[1]}</em>
              </h2>
              <p class="lede">{c.body}</p>
            </div>
          </div>
        </article>
      ))
    }

    <!-- The car park: contact -->
    <section class="ch finale" id="contact" data-ch aria-labelledby="contact-title">
      <i class="snap" aria-hidden="true"></i>
      <div class="copy wrap">
        <div class="text">
          <p class="eyebrow">Contact</p>
          <h2 id="contact-title">Let's make <em>something.</em></h2>
          <p class="lede">I'm not taking regular photography jobs for now. If it's creative, or it's brand or tech, I'm in. Coffee's on me.</p>
          <p class="actions">
            <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=Coffee%3F`}>Email me</a>
            <a class="btn" href={SITE.social.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
            <a class="btn" href={SITE.social.instagram} target="_blank" rel="me noopener">Instagram</a>
          </p>
          <p class="more">
            <a href="/portfolio">Portfolio</a>
            <a href="/gallery">Gallery</a>
            <a href="/play">Play</a>
            <a href="/articles">Articles</a>
            <a href="/resume">Resume</a>
          </p>
        </div>
      </div>
    </section>

    <!-- The footer scrolls up over the scene, so the car stays in view to the very end -->
    <div class="foot">
      <i class="snap end" aria-hidden="true"></i>
      <Footer overlay />
    </div>
  </div>
</section>

<script type="application/json" id="pass-data" set:html={JSON.stringify(passData)} />
<script type="application/json" id="pass-cards" set:html={JSON.stringify(cards)} />

<style>
  .pass {
    position: relative;
    --tint: 1;
    background: radial-gradient(120% 80% at 50% 100%, #141d33 0%, #070912 60%, #04050a 100%);
  }
  .view {
    position: sticky;
    top: 0;
    /* The full screen with the browser's bars tucked away (100lvh), not the smaller screen with them showing
       (100svh): otherwise, once a phone hides its address bar, a strip of plain background shows under it. */
    height: 100lvh;
    overflow: hidden;
  }
  .view .still,
  .view canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .view .still {
    object-fit: cover;
    opacity: 0.55;
  }
  .view canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .view canvas[data-ready] {
    opacity: 1;
  }
  /* The picture story (when the 3D can't run): one photo per chapter, crossfading as you scroll, each
     drifting slowly closer while it's on screen. */
  .slides {
    display: none;
  }
  .pass[data-fallback] .slides {
    display: block;
    position: absolute;
    inset: 0;
  }
  .pass:not([data-fallback]) .slides-only {
    display: none;
  }
  /* Lite mode on a phone: a way to opt in to the 3D scene (the script unhides it when it applies) */
  .load3d {
    display: block;
    margin: 0.7rem auto 0;
    padding: 0.55rem 1.1rem;
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--text);
    background: rgba(8, 10, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    cursor: pointer;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }
  .load3d[hidden] {
    display: none;
  }
  .pass:not([data-fallback]) .load3d {
    display: none;
  }
  /* Fixed and above the site header (z-index 50), which would otherwise cover it and take the tap */
  .liteback {
    position: fixed;
    z-index: 60;
    top: calc(env(safe-area-inset-top) + 0.9rem);
    left: var(--gutter);
    padding: 0.4rem 0.85rem;
    font: inherit;
    font-size: 0.74rem;
    color: var(--text-2);
    background: rgba(8, 10, 18, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .liteback[hidden],
  .pass[data-fallback] .liteback {
    display: none;
  }
  .liteback.away {
    opacity: 0;
    visibility: hidden;
  }
  .pass[data-fallback] canvas,
  .pass[data-fallback] .labels {
    display: none;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s var(--ease);
  }
  .slide::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(4, 5, 10, 0.55), rgba(4, 5, 10, 0.15) 30%, rgba(4, 5, 10, 0.25) 70%, rgba(4, 5, 10, 0.75)),
      radial-gradient(130% 90% at 50% 45%, transparent 50%, rgba(4, 5, 10, 0.55));
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 9s linear;
  }
  .slide.on {
    opacity: 1;
  }
  .slide.on img {
    transform: scale(1.1);
  }
  @media (prefers-reduced-motion: reduce) {
    .slide img,
    .slide.on img {
      transform: none;
      transition: none;
    }
  }
  /* The opening frame is tinted; the tint lifts as you start to scroll. */
  .tint {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(var(--tint) * 0.55);
    background:
      radial-gradient(90% 70% at 50% 46%, rgba(232, 162, 90, 0.16), transparent 70%),
      linear-gradient(160deg, rgba(34, 44, 96, 0.72), rgba(10, 8, 26, 0.78) 55%, rgba(60, 26, 20, 0.6));
  }
  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(4, 5, 10, 0.5), transparent 20%),
      radial-gradient(130% 90% at 50% 45%, transparent 55%, rgba(4, 5, 10, 0.6) 100%);
  }
  .labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .labels :global(.lab) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    white-space: nowrap;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text);
    text-shadow: 0 1px 6px #000, 0 0 2px #000;
    transition: opacity 0.35s ease;
    will-change: transform;
  }
  .labels :global(.lab.hub) {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c);
  }
  .labels :global(.lab.l3) {
    font-size: 0.68rem;
    color: var(--text-2);
  }
  .labels :global(.lab.sel) {
    font-weight: 700;
    color: #fff;
  }

  /* The ticker: a column of short lines on the right. The current one is longer and shows its label. */
  .rail {
    position: absolute;
    right: max(0.5rem, env(safe-area-inset-right));
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rail button {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    width: 100%;
    height: 22px;
    padding: 0 0.4rem;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--text-2);
    font: inherit;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rail button span {
    opacity: 0;
    transition: opacity 0.3s;
    text-shadow: 0 1px 6px #000;
  }
  .rail button::after {
    content: "";
    width: 12px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
    transition:
      width 0.3s var(--ease),
      opacity 0.3s;
  }
  .rail button:hover span,
  .rail button:focus-visible span,
  .rail button[aria-current] span {
    opacity: 1;
  }
  .rail button[aria-current] {
    color: var(--gold);
  }
  .rail button[aria-current]::after {
    width: 26px;
    opacity: 1;
  }

  .flow {
    position: relative;
    margin-top: -100lvh;
    overflow-x: clip; /* the dark patches behind chapter text reach past the screen edge on phones */
  }
  /* Scrolling rests on each section and never skips one. On touch screens that is the browser's own
     scroll snapping: each section carries a screen-sized marker at its middle, and the footer's marker sits
     at the very end. With a mouse or trackpad, the script below steps one section per scroll instead. */
  @media (hover: none) {
    :global(html:has(.pass)) {
      scroll-snap-type: y mandatory;
    }
  }
  .snap {
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 100svh;
    transform: translateY(-50%);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    pointer-events: none;
  }
  .snap.end {
    top: auto;
    bottom: 0;
    transform: none;
    scroll-snap-align: end;
  }
  .ch {
    position: relative;
    min-height: 135svh;
    display: grid;
    align-items: center;
    padding-block: 18svh;
  }
  .ch .text {
    max-width: 30rem;
    padding: 1.4rem 0;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.9s var(--ease);
  }
  .ch.on .text {
    opacity: 1;
    transform: none;
  }
  .story:nth-of-type(even) .text {
    margin-left: auto;
    margin-right: 2.5rem;
  }
  /* A soft dark patch behind chapter text, so it reads over a lit road */
  .story .text {
    position: relative;
    isolation: isolate;
  }
  .story .text::before {
    content: "";
    position: absolute;
    inset: -3rem -4rem;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(4, 5, 10, 0.9), rgba(4, 5, 10, 0.72) 62%, transparent);
    pointer-events: none;
  }
  /* Contact waits for the car to stop */
  .ch.finale .text {
    opacity: 0;
    transform: translateY(28px);
  }
  .ch.finale.ready .text {
    opacity: 1;
    transform: none;
  }
  .ch h2,
  .ch .lede,
  .ch .eyebrow,
  .hint {
    text-shadow:
      0 2px 18px rgba(3, 4, 9, 0.95),
      0 0 3px rgba(3, 4, 9, 0.8);
  }
  .eyebrow .n {
    color: var(--text);
    opacity: 0.6;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.1rem, 5.2vw, 3.9rem);
    line-height: 1.03;
    letter-spacing: -0.02em;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }
  h2 em {
    font-style: italic;
    color: var(--gold);
  }
  .ch .lede {
    color: var(--text);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
  }

  /* The sky */
  .ch.sky {
    display: block;
    min-height: 100svh;
    height: 100svh;
    padding-block: 0;
    position: relative;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* The name sits on the centre star. The scene moves it; without 3D it rests in the middle. */
  .me {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    width: 0;
    height: 0;
    transform: translate(50vw, 44svh);
    pointer-events: none;
    will-change: transform;
  }
  .me .wordmark {
    position: absolute;
    left: 0;
    top: 1.5rem;
    width: min(62vw, 21rem);
    max-width: none;
    height: auto;
    transform: translateX(-50%);
    filter: drop-shadow(0 2px 14px rgba(3, 4, 9, 0.95));
  }
  .me .who {
    position: absolute;
    left: 0;
    top: calc(1.5rem + min(62vw, 21rem) * 0.082 + 0.85rem);
    width: max-content;
    max-width: 86vw;
    transform: translateX(-50%);
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--gold);
    text-shadow:
      0 2px 14px rgba(3, 4, 9, 0.95),
      0 0 3px rgba(3, 4, 9, 0.8);
  }
  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(1.2rem, env(safe-area-inset-bottom));
    margin: 0;
    padding-inline: var(--gutter);
    text-align: center;
    font-size: 0.74rem;
    color: var(--text-2);
  }
  .hint .go {
    display: block;
    margin-top: 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hint i {
    display: block;
    width: 1px;
    height: 26px;
    margin: 0.5rem auto 0;
    background: linear-gradient(var(--gold), transparent);
    animation: drop 2s var(--ease) infinite;
  }
  @keyframes drop {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    60% {
      transform: scaleY(1);
      transform-origin: top;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
  .touch-only {
    display: none;
  }
  @media (hover: none) {
    .touch-only {
      display: inline;
    }
    .mouse-only {
      display: none;
    }
