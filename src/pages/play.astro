---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { abs, breadcrumbSchema, PERSON_ID } from "../lib/schema";
import header from "../assets/photos/automotive-header.jpg";
import { LENSES, TIMES } from "../scripts/sim/data";

const schema = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Play", path: "/play" },
  ]),
  {
    "@type": "VideoGame",
    name: "Photography Simulator",
    alternateName: ["Photographer Simulator", "Camera simulator"],
    url: abs("/play"),
    description:
      "A free, browser-based 3D photography simulator. Walk around a car at a mountain-pass lay-by, drive it into position, pick the time of day, choose from seven prime lenses, set shutter speed, aperture, ISO and flash, and take photos rendered with physically based exposure, depth of field and motion blur. Photos are kept in a gallery and can be exported as a PDF shoot guide.",
    genre: ["Simulation"],
    gamePlatform: "Web browser",
    applicationCategory: "Game",
    operatingSystem: "Any",
    author: { "@id": PERSON_ID },
    offers: { "@type": "Offer", price: "0", priceCurrency: "MYR" },
  },
];
---

<Base
  title="Photography Simulator: a free 3D camera game"
  description="A free photography simulator in your browser. Walk around a car at a mountain pass from morning to night, drive it into position, pick a lens from 16mm to 200mm, set shutter, aperture, ISO and flash, and take real photos with physically based exposure, depth of field and motion blur. Export your shoot as a PDF guide. Built with three.js by andriantam."
  schema={schema}
>
  <PageHero
    image={header}
    eyebrow="Play · Photography simulator"
    title="Photography Simulator"
    intro="A free 3D photography simulator you play in the browser. A car you can drive into position, a mountain-pass lay-by from morning to night, and a camera bag with seven lenses. Every photo is rendered from the 3D scene with real exposure, depth of field and motion blur."
    compact
    crumbs={[{ name: "Home", path: "/" }, { name: "Play", path: "/play" }]}
  />

  <section class="wrap sim-wrap">
    <div class="sim" data-sim style="--ar:3 / 2;--roll:0rad">
      <div class="stage" data-stage>
        <!-- The frame keeps the photo's shape (3:2 or 2:3); everything outside it is the stage's dark surround. -->
        <div class="frame" data-frame>
          <canvas data-canvas tabindex="0" aria-label="3D photography simulator view. Drag to look, click to take a photo."></canvas>
          <div class="vf" aria-hidden="true">
            <div class="grid"></div>
            <div class="level"><i></i></div>
            <div class="af" data-af></div>
            <div class="vf-rec" data-rec></div>
            <div class="vf-bar">
              <span data-vf-lens></span>
              <span data-vf-shutter></span>
              <span data-vf-ap></span>
              <span data-vf-iso></span>
              <span class="meter" data-vf-meter><i></i><b data-vf-meterval></b></span>
              <span class="fl" data-vf-flash></span>
              <span data-vf-focus></span>
            </div>
            <div class="vf-boost" data-vf-boost hidden>Viewfinder brightened · photo will be darker</div>
          </div>
          <div class="flash-fx" data-flashfx aria-hidden="true"></div>
        </div>

        <div class="top-hud">
          <span data-stance></span>
          <span class="prompt" data-prompt></span>
        </div>
        <!-- Tapped by script when the shutter fires: on iPhone (iOS 18+) toggling a switch gives a haptic tick. -->
        <label class="haptic" data-haptic aria-hidden="true"><input type="checkbox" switch tabindex="-1" /></label>
        <button type="button" class="settings-btn" data-panel-toggle aria-expanded="false">Camera settings</button>
        <div class="tools">
          <button type="button" class="tool sound-btn" data-sound aria-pressed="true" aria-label="Sound on. Turn sound off" title="Sound (M)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor" /><path class="waves" d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><path class="mute" d="M16.5 9.5l5 5M21.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
          <button type="button" class="tool full-btn" data-full aria-label="Full screen">⛶</button>
          <button type="button" class="tool exit-btn" data-exit aria-label="Minimise the game and see your photos">✕</button>
        </div>
        <div class="preview" data-preview hidden role="dialog" aria-label="Photo preview">
          <div class="preview-card">
            <img alt="The photo you just took" />
            <p class="preview-title" data-preview-title></p>
            <p class="preview-meta" data-preview-meta></p>
            <p class="preview-ev" data-preview-ev></p>
            <div class="preview-actions">
              <button type="button" class="btn btn-primary" data-preview-close>Keep shooting</button>
              <button type="button" class="btn" data-preview-open>Open in gallery</button>
            </div>
          </div>
        </div>
        <button type="button" class="chip" data-chip hidden aria-label="Review your latest photo"><img alt="" /></button>
        <div class="develop" data-develop hidden><span>Developing</span><div class="bar"><i data-develop-bar></i></div></div>

        <div class="touch" aria-hidden="true">
          <div class="joy" data-joy><div class="knob" data-knob></div></div>
          <div class="tbtns">
            <button type="button" class="walk" data-touch-btn="jump">Jump</button>
            <button type="button" class="walk" data-touch-btn="crouch">Crouch</button>
            <button type="button" class="walk" data-touch-btn="prone">Lie flat</button>
            <button type="button" class="walk" data-touch-btn="af">AF lock</button>
            <button type="button" class="walk" data-touch-btn="ladder">Ladder</button>
            <button type="button" class="walk" data-touch-btn="carry">Carry</button>
            <button type="button" class="walk" data-touch-btn="drive">Drive</button>
            <button type="button" class="walk gyro" data-gyro aria-pressed="false">Gyro off</button>
            <button type="button" class="drv" data-touch-btn="drive">Get out</button>
            <button type="button" class="drv" data-touch-btn="lights">Lights</button>
          </div>
          <button type="button" class="brake-btn" data-touch-btn="brake">Brake</button>
          <button type="button" class="shutter-btn" data-touch-btn="shutter"><i aria-hidden="true"></i><span>Take photo</span></button>
        </div>

        <div class="overlay" data-overlay>
          <div class="card">
            <p class="kicker">A shoot at the pass</p>
            <p class="status" data-status role="status">Loading the simulator…</p>
            <button type="button" class="btn btn-primary" data-start disabled>Loading…</button>
            <div class="keys desk">
              <p><b>Look</b> drag the view · <b>Shoot</b> click, or Enter · <b>Focus lock</b> hold right click</p>
              <p><b>Move</b> W A S D, Shift to run · <b>Jump</b> Space · <b>Crouch</b> C · <b>Lie flat</b> Z</p>
              <p><b>Portrait or landscape</b> V · <b>Tilt</b> Q and X, L to level · <b>Balance exposure</b> B</p>
              <p><b>Ladder</b> E climb, R pick up or put down · <b>Car</b> E to get in, W S A D, Space brake, H lights</p>
              <p><b>Lens</b> 1 to 7 · <b>Shutter</b> scroll · <b>Aperture</b> Shift+scroll · <b>ISO</b> - = · <b>Flash</b> F · <b>Time</b> T · <b>Sound</b> M</p>
            </div>
            <div class="keys mob">
              <p>Left thumb: walk. Drag anywhere else to look (or tap Gyro and move your phone), twist two fingers to tilt, tap Take photo to shoot.</p>
              <p>Settings has lenses, exposure and the frame. The speaker turns sound on or off, and ✕ minimises the game so you can see your photos.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="panel" data-panel>
        <div class="scene-row">
          <div class="times" role="group" aria-label="Time of day">
            {TIMES.map((t) => <button type="button" data-time={t.id} aria-pressed={t.id === "evening" ? "true" : "false"} title={t.blurb}>{t.label}</button>)}
          </div>
          <button type="button" class="lights-toggle" data-lights aria-pressed="false">Car lights off</button>
        </div>
        <div class="frame-row">
          <button type="button" class="pill" data-orient aria-pressed="false" title="Portrait or landscape (V)">Landscape</button>
          <div class="dial tilt" role="group" aria-label="Camera tilt">
            <span class="lbl">Tilt</span>
            <button type="button" data-tilt="-1" aria-label="Tilt left">↺</button>
            <b data-val="tilt">0°</b>
            <button type="button" data-tilt="1" aria-label="Tilt right">↻</button>
            <button type="button" class="level-btn" data-tilt="0">Level</button>
          </div>
          <button type="button" class="pill balance" data-balance title="Balanced exposure (B)">Balance exposure</button>
        </div>
        <div class="lenses" role="group" aria-label="Lens">
          {LENSES.map((l, i) => <button type="button" data-lens={i} aria-pressed={i === 2 ? "true" : "false"}>{l.focal}mm<span>f/{l.maxAperture}</span></button>)}
        </div>
        <div class="dials">
          <div class="dial"><span class="lbl">Shutter</span><button type="button" data-step="shutter" data-dir="-1" aria-label="Slower shutter">−</button><b data-val="shutter">1/60</b><button type="button" data-step="shutter" data-dir="1" aria-label="Faster shutter">+</button></div>
          <div class="dial"><span class="lbl">Aperture</span><button type="button" data-step="aperture" data-dir="-1" aria-label="Wider aperture">−</button><b data-val="aperture">f/5.6</b><button type="button" data-step="aperture" data-dir="1" aria-label="Narrower aperture">+</button></div>
          <div class="dial"><span class="lbl">ISO</span><button type="button" data-step="iso" data-dir="-1" aria-label="Lower ISO">−</button><b data-val="iso">100</b><button type="button" data-step="iso" data-dir="1" aria-label="Higher ISO">+</button></div>
          <div class="dial"><button type="button" class="flash-toggle" data-flash aria-pressed="false">Flash off</button><button type="button" data-step="power" data-dir="1" aria-label="Lower flash power">−</button><b data-val="power">1/1</b><button type="button" data-step="power" data-dir="-1" aria-label="Higher flash power">+</button></div>
        </div>
      </div>
    </div>

    <section class="gallery" data-gallery aria-labelledby="gallery-title">
      <div class="g-head">
        <div>
          <h2 id="gallery-title">Your shoot</h2>
          <p class="g-sub">Kept in this browser only. <span data-g-count></span></p>
          <p class="g-note" data-g-note></p>
        </div>
        <button type="button" class="btn btn-primary" data-g-export disabled>Export shoot guide</button>
      </div>
      <div class="g-bar">
        <label class="g-all"><input type="checkbox" data-g-all disabled /> Select all</label>
        <span class="g-selcount" data-g-selcount></span>
        <button type="button" class="g-btn" data-g-download disabled>Download</button>
        <button type="button" class="g-btn danger" data-g-delete disabled>Delete</button>
        <label class="g-frame"><input type="checkbox" data-g-frame checked /> Settings frame on downloads</label>
      </div>
      <p class="g-empty" data-g-empty>Photos you take show up here. Open one to see it full screen with its histogram and settings.</p>
      <ul class="g-grid" data-g-grid></ul>

      <dialog class="lb" data-lb aria-label="Photo viewer">
        <div class="lb-top">
          <span class="lb-count" data-lb-count></span>
          <div class="lb-tools">
            <button type="button" data-lb-info aria-pressed="false">Info</button>
            <button type="button" data-lb-dl>Download</button>
            <button type="button" data-lb-del>Delete</button>
            <button type="button" data-lb-fs aria-pressed="false">Full screen</button>
            <button type="button" class="lb-x" data-lb-close aria-label="Close viewer">×</button>
          </div>
        </div>
        <div class="lb-body">
          <div class="lb-stage" data-lb-stage>
            <button type="button" class="lb-nav prev" data-lb-prev aria-label="Previous photo">‹</button>
            <figure class="lb-print">
              <img data-lb-img alt="" />
              <figcaption data-lb-cap></figcaption>
            </figure>
            <button type="button" class="lb-nav next" data-lb-next aria-label="Next photo">›</button>
          </div>
          <aside class="lb-info">
            <canvas data-lb-hist width="256" height="60" aria-label="Histogram"></canvas>
            <p class="clip" data-lb-clip></p>
            <dl data-lb-meta></dl>
          </aside>
        </div>
      </dialog>

      <dialog class="ex" data-ex aria-labelledby="ex-title">
        <form data-ex-form>
          <h2 id="ex-title">Export shoot guide</h2>
          <p class="ex-sub">A printable A4 PDF: a cover with your notes and a contact sheet, then every shot with its settings, camera position and light.</p>
          <label>Event name <input name="event" required maxlength="120" placeholder="e.g. WRX golden hour shoot" /></label>
          <label>Description <textarea name="description" rows="3" maxlength="1500" placeholder="What the shoot is for, the client, the look you're after"></textarea></label>
          <label>Notes <textarea name="notes" rows="3" maxlength="2000" placeholder="Reminders for the day: kit, timing, permits, shot list"></textarea></label>
          <fieldset>
            <legend>Photos</legend>
            <label class="radio"><input type="radio" name="scope" value="selected" data-ex-scope="selected" /> Selected (<span data-ex-selcount>0</span>)</label>
            <label class="radio"><input type="radio" name="scope" value="all" data-ex-scope="all" /> Whole gallery (<span data-ex-allcount>0</span>)</label>
          </fieldset>
          <p class="ex-status" data-ex-status role="status"></p>
          <div class="ex-actions">
            <button type="button" class="btn" data-ex-cancel>Cancel</button>
            <button type="submit" class="btn btn-primary" data-ex-go>Export PDF</button>
          </div>
        </form>
      </dialog>

      <div class="toast" data-toast role="status" hidden><span data-toast-msg></span><button type="button" data-toast-undo>Undo</button></div>
    </section>

    <div class="how prose">
      <h2>How the photography simulator works</h2>
      <p>
        This photography simulator is a way to learn shutter speed, aperture and ISO by shooting, without buying a camera. Nothing
        here is faked with filters. When you press the shutter, the simulator renders the 3D scene dozens of times and
        averages the results, the way a sensor collects light while the shutter is open.
      </p>
      <ul>
        <li>
          <strong>Exposure</strong> follows the real formula. The scene is lit at about EV 11.5, golden hour with the sun on the
          horizon. Every stop of shutter, aperture or ISO doubles or halves the light, and anything brighter than the sensor can
          hold blows out to white.
        </li>
        <li>
          <strong>Depth of field</strong> comes from moving the camera across the lens opening for each sample while keeping the
          focus plane fixed. Wide apertures and long lenses give shallow focus; stopped down, the out-of-focus highlights take the
          shape of the aperture blades.
        </li>
        <li>
          <strong>Motion blur</strong> uses your actual mouse or finger movement during the exposure. Hold still at 1/8 s, or
          move during a 5 s exposure and watch it smear.
        </li>
        <li>
          <strong>Flash</strong> follows the inverse-square law with a guide number of 60. It fires at the start of the exposure,
          so it freezes what it lights even during a long shutter, and it can't sync faster than 1/250 s.
        </li>
        <li><strong>ISO</strong> brightens the image and adds noise that grows with the gain, as on a real sensor.</li>
        <li>
          <strong>Time of day</strong> swaps in a real HDR sky. The sun is measured from the photo and becomes the light that casts
          shadows: about EV 14 mid-morning, EV 15 at noon, EV 11.5 at golden hour and EV -4 on a moonless night. At night the lay-by's
          street light and the car's lamps are the main light, in real units (a 28 lux pool under the lamp, 12,000 cd low beams).
        </li>
        <li>
          <strong>The car</strong> drives on a simple bicycle model, steering the front wheels and turning about the rear axle, so you
          can park it where the light is best.
        </li>
      </ul>
      <p>
        Lenses: {LENSES.map((l) => l.name).join(", ")}, each with its own closest focusing distance and number of aperture blades.
        Built with three.js. Car model:
        based on <a href="https://sketchfab.com/3d-models/subaru-wrx-sti-36f4a47b619a49bda4c1870e7833b25b" target="_blank" rel="noopener">"Subaru WRX STI"</a> by
        <a href="https://sketchfab.com/skyfaltus" target="_blank" rel="noopener">skyfaltus (Skyborg)</a>, licensed under
        <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>. Simplified for the web, with materials adjusted and lamps switched off.
        The skies are real HDR photos from Poly Haven (CC0): "Camdeboo Road" by Dario Barresi and Jarod Guest for the evening, and
        "Qwantani" mid-morning, noon and night by Greg Zaal and Jarod Guest. The ground textures are also from Poly Haven.
      </p>
    </div>
  </section>
</Base>

<style>
  .sim-wrap {
    padding-bottom: 6rem;
  }
  .sim {
    max-width: 1200px;
    margin: 0 auto;
  }
  .stage {
    position: relative;
    aspect-ratio: var(--ar);
    width: min(100%, calc(82svh * (var(--ar))));
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    container-type: size;
  }
  /* The photo's frame, as large as fits inside the stage */
  .frame {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(100cqw, calc(100cqh * (var(--ar))));
    aspect-ratio: var(--ar);
    height: auto;
  }
  :global(.is-driving) .frame {
    width: 100cqw;
    height: 100cqh;
    aspect-ratio: auto;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    outline: none;
  }
  :global(.is-dragging) canvas {
    cursor: grabbing;
  }
  .vf {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global(.is-driving) .vf {
    display: none;
  }
  /* Electronic level: a horizon line that turns green when the camera is level */
  .level {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .level i {
    width: 22%;
    height: 2px;
    background: rgba(255, 255, 255, 0.55);
    transform: rotate(calc(-1 * var(--roll)));
    transition: background 0.15s;
  }
  :global(.is-level) .level i {
    background: #6ee07a;
  }
  .grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, transparent calc(33.33% - 0.5px), rgba(255, 255, 255, 0.14) 33.33%, transparent calc(33.33% + 0.5px), transparent calc(66.66% - 0.5px), rgba(255, 255, 255, 0.14) 66.66%, transparent calc(66.66% + 0.5px)),
      linear-gradient(to bottom, transparent calc(33.33% - 0.5px), rgba(255, 255, 255, 0.14) 33.33%, transparent calc(33.33% + 0.5px), transparent calc(66.66% - 0.5px), rgba(255, 255, 255, 0.14) 66.66%, transparent calc(66.66% + 0.5px));
  }
  .af {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 7%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border: 2px solid #6ee07a;
    border-radius: 3px;
  }
  .af:global(.bad) {
    border-color: #ff5a4a;
  }
  .af:global(.locked) {
    border-style: dashed;
    border-color: #ffd36a;
  }
  .vf-rec {
    position: absolute;
    top: 0.8rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.85rem;
    color: #ff6b5e;
    text-shadow: 0 1px 4px #000;
  }
  .vf-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    gap: clamp(0.5rem, 2vw, 1.4rem);
    justify-content: center;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.55);
    color: #f1f1f1;
    font-size: clamp(0.66rem, 1.4vw, 0.9rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
  }
  .vf-boost {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    font-size: 0.7rem;
    color: #ffd36a;
    background: rgba(0, 0, 0, 0.5);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }
  .vf-boost[hidden] {
    display: none;
  }
  .fl:global(.on) {
    color: #ffd36a;
  }
  .meter {
    --m: 0;
    position: relative;
    width: clamp(70px, 12vw, 120px);
    height: 14px;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.5) 1px, transparent 1px) 0 50% / 16.666% 6px repeat-x;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
  }
  .meter i {
    position: absolute;
    left: calc(50% + var(--m) * 50%);
    bottom: -4px;
    width: 3px;
    height: 12px;
    margin-left: -1.5px;
    background: #ffd36a;
  }
  .meter b {
    position: absolute;
    top: -1.1em;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75em;
    font-weight: 500;
    opacity: 0.8;
  }
  .flash-fx {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .flash-fx:global(.go) {
    animation: fl 0.25s ease-out;
  }
  @keyframes fl {
    0% {
      opacity: 0.85;
    }
    100% {
      opacity: 0;
    }
  }
  .top-hud {
    position: absolute;
    top: 0.6rem;
    left: 0.75rem;
    right: 0.75rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 4px #000;
    pointer-events: none;
  }
  .prompt {
    color: #ffd36a;
  }
  .overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(11, 10, 14, 0.62);
    padding: 1rem;
    overflow: auto;
  }
  .overlay[hidden] {
    display: none;
  }
  .card .btn {
    margin: 0.75rem 0 1rem;
  }
  .card {
    background: rgba(19, 17, 24, 0.95);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: clamp(1rem, 3vw, 1.75rem);
    max-width: 640px;
    width: 100%;
    text-align: center;
  }
  .kicker {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    margin-bottom: 0.25rem;
  }
  .status {
    color: var(--gold);
    font-size: 0.9rem;
  }
  .keys {
    text-align: left;
    font-size: 0.85rem;
    color: var(--text-2);
    margin: 0 0 1.25rem;
  }
  .keys p {
    margin: 0 0 0.35rem;
  }
  .keys b {
    color: var(--text);
    font-weight: 600;
  }
  .mob {
    display: none;
  }
  :global(.is-touch) .mob {
    display: block;
  }
  :global(.is-touch) .desk {
    display: none;
  }

  /* Touch controls */
  .touch {
