---
// Photography: what I shot, selected work, clients and testimonials. Moved here from the home page.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Slide from "../components/Slide.astro";
import FlickrImg from "../components/FlickrImg.astro";
import { SERVICES, CLIENTS, TESTIMONIALS, FAQ, FEATURED_ALBUMS } from "../data/content";
import { getAlbums, CATEGORY_LABELS } from "../lib/flickr";
import { breadcrumbSchema, faqSchema } from "../lib/schema";

import hero from "../assets/photos/automotive-header.jpg";
import bgServices from "../assets/photos/me.jpg";
import bgWork from "../assets/photos/portfolio-header.jpg";
import bgClients from "../assets/photos/events-header.jpg";
import bgVoices from "../assets/photos/testimonials-bg.jpg";
import bgContact from "../assets/photos/footer-bg.jpg";

const brandFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/brands/*", { eager: true });
const faceFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/testimonials/*", { eager: true });
const brand = (f: string) => brandFiles[`../assets/brands/${f}`]?.default;
const face = (f: string) => faceFiles[`../assets/testimonials/${f}`]?.default;

const albums = await getAlbums();
const featured = FEATURED_ALBUMS.map((t) => albums.find((a) => a.title === t)).filter((a) => a?.cover) as typeof albums;
const totalPhotos = albums.reduce((n, a) => n + a.count, 0);

const TOTAL = 5;
const schema = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Photography", path: "/photography" },
  ]),
  faqSchema(FAQ),
];
---

<Base
  title="Photography"
  description="Fifteen years of photography by Andrian Tam: automotive and motorsport, events, weddings, products and film. No longer taking commissions, but always happy to talk photography over coffee."
  schema={schema}
>
  <PageHero
    image={hero}
    eyebrow="Photography"
    title="Fifteen years behind the camera"
    intro="Automotive and motorsport, events, weddings and film. I shot for clients for years; now I shoot for myself. I'm not taking commissions, but I'm always up for a coffee and a chat about photography."
    crumbs={[{ name: "Home", path: "/" }, { name: "Photography", path: "/photography" }]}
  />

  <!-- 02 Services -->
  <Slide id="services" index={1} total={TOTAL} label="Services" image={bgServices} position="center 30%" dim={0.78} tall>
    <div class="head reveal">
      <p class="eyebrow">What I shot</p>
      <h2 id="services-title">Photo, video and everything in between</h2>
      <p class="lede">
        For years I covered automotive and motorsport, corporate events, weddings and products for clients. I've stepped back from
        commissions, so this is a record of the work rather than a menu.
      </p>
    </div>
    <ul class="services">
      {
        SERVICES.filter((s) => s.title !== "Tech consulting").map((s, i) => (
          <li class="service reveal">
            <div class="service-img">
              <Image src={s.image} alt={s.alt} widths={[360, 540, 720]} sizes="(min-width: 1000px) 280px, 45vw" class="reveal-zoom" format="avif" />
            </div>
            <div class="service-body">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3>
              <p class="outcome">{s.outcome}</p>
              <p class="desc">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Slide>

  <!-- 03 Selected work -->
  <Slide id="work" index={2} total={TOTAL} label="Selected work" image={bgWork} dim={0.8} tall>
    <div class="head reveal">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-title">Shoots I loved</h2>
      <p class="lede">{albums.length} albums and {totalPhotos.toLocaleString("en")} photos, from Sepang to Sydney.</p>
    </div>
    <ul class="work">
      {
        featured.map((a, i) => (
          <li class:list={["work-item reveal-wipe", { wide: i === 0 || i === 3 }]}>
            <a href={`/portfolio/${a.slug}`}>
              <FlickrImg photo={a.cover!} alt={`${a.title}, photographed by Andrian Tam`} sizes="(min-width: 900px) 50vw, 100vw" />
              <span class="work-meta">
                <span class="work-cat">{a.categories.map((c) => CATEGORY_LABELS[c] ?? c)[0]}</span>
                <span class="work-title">{a.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="more reveal"><a class="btn" href="/portfolio">Browse the full portfolio →</a></p>
  </Slide>

  <!-- 04 Clients -->
  <Slide id="clients" index={3} total={TOTAL} label="Clients" image={bgClients} dim={0.84}>
    <div class="head reveal">
      <p class="eyebrow">Worked with</p>
      <h2 id="clients-title">Brands, events and owners' clubs</h2>
      <p class="lede">Carmakers, motorsport series, corporate clients and the people who love their cars.</p>
    </div>
    <ul class="logos reveal-stagger">
      {
        CLIENTS.map((c) => {
          const img = brand(c.file);
          if (!img) return null;
          const logo = <Image src={img} alt={c.name} height={120} densities={[1, 2]} format="webp" />;
          return <li title={c.name}>{c.url ? <a href={c.url} target="_blank" rel="noopener">{logo}</a> : logo}</li>;
        })
      }
    </ul>
  </Slide>

  <!-- 05 Testimonials -->
  <Slide id="voices" index={4} total={TOTAL} label="Testimonials" image={bgVoices} dim={0.82}>
    <div class="head reveal">
      <p class="eyebrow">Kind words</p>
      <h2 id="voices-title">What clients said</h2>
    </div>
    <div class="quotes-wrap reveal">
      <ul class="quotes" tabindex="0" aria-label="Testimonials, scroll sideways">
        {
          TESTIMONIALS.map((t) => {
            const img = face(t.photo);
            return (
              <li class="quote">
                <blockquote>
                  <p>“{t.quote}”</p>
                </blockquote>
                <div class="who">
                  {img && <Image src={img} alt="" width={56} height={56} densities={[1, 2]} format="webp" />}
                  <span>
                    <strong>{t.name}</strong>
                    <span>{t.context}</span>
                  </span>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </Slide>

  <!-- 05 Questions -->
  <Slide id="questions" index={5} total={TOTAL} label="Questions" image={bgContact} dim={0.8} tall>
    <div class="contact">
      <div class="reveal">
        <p class="eyebrow">Not taking bookings</p>
        <h2 id="questions-title">Photography is a passion again</h2>
        <p class="lede">
          I no longer shoot for clients. Photography is back to being a hobby I love, without the noise or anyone's brief. If you
          want to talk cameras, cars, film or how to get started, the coffee's on me.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/#contact">Grab a coffee</a>
          <a class="btn" href="/portfolio">Browse the portfolio</a>
        </div>
      </div>
      <div class="faq reveal">
        <h3>Common questions</h3>
        {
          FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </Slide>
</Base>

<style>
  .hero-title {
    font-size: clamp(3.2rem, 11vw, 8.5rem);
    line-height: 0.95;
    margin-bottom: 0.25em;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: var(--text);
    max-width: 30ch;
  }
  .beat-big {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 4.4rem);
    line-height: 1.05;
    margin-bottom: 0.4em;
  }
  .beat-small {
    color: var(--text-2);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }
  [data-align="right"] .beat-small {
    margin-left: auto;
    max-width: 40ch;
  }

  .head {
    max-width: 760px;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  /* Services */
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 1.25rem;
  }
  .service {
    background: rgba(19, 17, 24, 0.72);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
  }
  .service-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .service-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .num {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--gold);
  }
  .service h3 {
    margin: 0.3rem 0 0.4rem;
  }
  .service h3 a {
    text-decoration: none;
  }
  .outcome {
    color: var(--text);
    font-weight: 500;
    font-size: 0.98rem;
    margin-bottom: 0.5rem;
  }
  .desc {
    color: var(--text-2);
    font-size: 0.92rem;
    margin: 0;
  }

  /* Work */
  .work {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .work-item.wide {
    grid-column: span 2;
  }
  .work-item a {
    position: relative;
    display: block;
    height: 100%;
    min-height: 260px;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
  }
  .work-item :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .work-item a:hover :global(img) {
    transform: scale(1.04);
  }
  .work-meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(11, 10, 14, 0.9), transparent);
    display: grid;
  }
  .work-cat {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .work-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text);
  }
  .more {
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .work {
      grid-template-columns: 1fr;
    }
    .work-item.wide {
      grid-column: auto;
    }
  }

  /* Clients */
  .logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.75rem;
  }
  .logos li {
    background: var(--paper);
    border-radius: var(--radius);
    height: 92px;
    display: grid;
    place-items: center;
    padding: 0.9rem 1.1rem;
  }
  .logos a {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 520px) {
    .logos {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .logos li {
      height: 64px;
      padding: 0.5rem 0.6rem;
    }
  }
  .logos :global(img) {
    max-height: 56px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.85;
    transition: filter 0.3s, opacity 0.3s;
  }
  .logos li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  /* Testimonials: CSS scroll-snap carousel */
  .quotes-wrap {
    margin-inline: calc(-1 * var(--gutter));
  }
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(420px, 82vw);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }
  .quote {
    scroll-snap-align: start;
    background: rgba(19, 17, 24, 0.78);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    backdrop-filter: blur(6px);
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.55;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
  }
  .who :global(img) {
    border-radius: 50%;
    width: 44px;
    height: 44px;
    object-fit: cover;
  }
  .who span {
    display: grid;
  }
  .who span span {
    color: var(--text-3);
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .socials {
    display: flex;
    gap: 1.25rem;
    color: var(--text-2);
  }
  .faq h3 {
    font-size: 1.3rem;
  }
  details {
    border-top: 1px solid var(--line);
    padding: 0.9rem 0;
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::after {
    content: "+";
    color: var(--gold);
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    color: var(--text-2);
    margin: 0.6rem 0 0;
  }
  .latest {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .latest h3 {
    font-size: 1rem;
    font-family: var(--font-body);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .latest ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem 2rem;
  }
  .latest a {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-decoration: none;
  }
  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
