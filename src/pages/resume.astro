---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { RESUME } from "../data/resume";
import { SITE } from "../config/site";
import { abs, breadcrumbSchema, personSchema } from "../lib/schema";
import header from "../assets/photos/laptop.jpg";
import headshot from "../assets/headshot.png";

const schema = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Resume", path: "/resume" },
  ]),
  { "@type": "ProfilePage", url: abs("/resume"), mainEntity: personSchema(true) },
];
---

<Base
  title="Resume"
  description="Resume of Andrian Tam: Head of Brand at TROOPERS Singapore, founder of Toge Business Solutions, and a software engineer with six years at McKinsey & Company, plus Isobar, VLT Labs and Samsung."
  type="profile"
  schema={schema}
>
  <PageHero
    image={header}
    eyebrow="Resume"
    title="Andrian Tam"
    intro={RESUME.summary}
    compact
    crumbs={[{ name: "Home", path: "/" }, { name: "Resume", path: "/resume" }]}
  />

  <div class="wrap resume">
    <aside class="side reveal">
      <Image src={headshot} alt="Portrait of Andrian Tam" width={200} height={206} densities={[1, 2]} class="face" format="webp" />
      <p class="roles">{RESUME.roles.join(" · ")}</p>
      <p class="muted">{RESUME.location}</p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p><a href={SITE.social.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a></p>
      <p><button type="button" class="btn" onclick="window.print()">Save as PDF</button></p>
    </aside>

    <div class="main">
      <section aria-labelledby="impact">
        <h2 id="impact">Impact at a glance</h2>
        <ul class="impact">
          {
            RESUME.highlights.map((h) => (
              <li class="reveal">
                <b>{h.value}</b>
                <span class="lbl">{h.label}</span>
                <span class="det">{h.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="exp">
        <h2 id="exp">Experience</h2>
        <ol class="timeline">
          {
            RESUME.experience.map((e) => (
              <li class="reveal">
                <div class="when">{e.period}</div>
                <div>
                  <h3>{e.title}</h3>
                  <p class="org">{e.url ? <a href={e.url} target="_blank" rel="noopener">{e.org}</a> : e.org}</p>
                  {e.tags.length > 0 && <p class="tags">{e.tags.join(" · ")}</p>}
                  {e.points.length > 0 && (
                    <ul>
                      {e.points.map((p) => <li>{p}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="skills">
        <h2 id="skills">Skills</h2>
        <dl class="skills">
          {
            RESUME.skills.map((s) => (
              <div class="reveal">
                <dt>{s.group}</dt>
                <dd>{s.items.join(", ")}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="awards">
        <h2 id="awards">Awards and certifications</h2>
        <ul class="plain">
          {RESUME.awards.map((a) => <li class="reveal"><span class="yr">{a.year}</span> <strong>{a.title}</strong>, {a.detail}</li>)}
        </ul>
      </section>

      <section aria-labelledby="edu">
        <h2 id="edu">Education</h2>
        <ul class="plain">
          {RESUME.education.map((e) => <li class="reveal"><span class="yr">{e.period}</span> <strong>{e.school}</strong>, {e.detail}</li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .resume {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: 6rem;
  }
  .side {
    position: sticky;
    top: 6rem;
    align-self: start;
  }
  .face {
    border-radius: 50%;
    width: 140px;
    height: 140px;
    object-fit: cover;
    border: 1px solid var(--gold);
    margin-bottom: 1rem;
  }
  .roles {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .muted {
    color: var(--text-3);
  }
  .side p {
    margin: 0 0 0.6rem;
  }
  h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-top: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }
  section + section {
    margin-top: 3.5rem;
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .when {
    color: var(--gold);
    font-size: 0.85rem;
    padding-top: 0.3rem;
  }
  .timeline h3 {
    margin: 0 0 0.2rem;
  }
  .org {
    color: var(--text-2);
    margin-bottom: 0.5rem;
  }
  .impact {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.75rem;
  }
  .impact li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .impact b {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--gold);
  }
  .impact .lbl {
    font-weight: 600;
  }
  .impact .det {
    font-size: 0.85rem;
    color: var(--text-3);
  }
  .tags {
    color: var(--text-3);
    font-size: 0.9rem;
  }
  .timeline ul {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-2);
    font-size: 0.97rem;
  }
  .timeline ul li {
    margin-bottom: 0.35rem;
  }
  .skills {
    margin: 0;
    display: grid;
    gap: 0.9rem;
  }
  .skills div {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 1.5rem;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: var(--text-2);
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
    color: var(--text-2);
  }
  .plain strong {
    color: var(--text);
    font-weight: 500;
  }
  .yr {
    display: inline-block;
    min-width: 7.5rem;
    color: var(--gold);
    font-size: 0.88rem;
  }
  @media (max-width: 820px) {
    .resume {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .timeline > li,
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.page-hero img),
    .btn {
      display: none !important;
    }
    :global(body) {
      background: #fff;
      color: #000;
    }
    :global(.page-hero) {
      min-height: 0 !important;
      padding: 0 !important;
    }
    .resume {
      grid-template-columns: 1fr;
    }
    .timeline ul,
    dd,
    .plain,
    .org {
      color: #222;
    }
  }
</style>
