---
import Base from "../layouts/Base.astro";
import Story from "../components/Story.astro";
import Slide from "../components/Slide.astro";
import { SITE } from "../config/site";
import { FEATURED_ALBUMS } from "../data/content";
import { getAlbums } from "../lib/flickr";
import { getArticles } from "../lib/blogger";

import bgContact from "../assets/photos/footer-bg.jpg";

const albums = await getAlbums();
const featured = FEATURED_ALBUMS.map((t) => albums.find((a) => a.title === t)).filter((a) => a?.cover) as typeof albums;
const latest = (await getArticles()).slice(0, 3);

const TOTAL = 2;
---

<Base
  preload={[
    { href: "/media/hero-poster-1280.webp", as: "image", type: "image/webp", media: "(orientation: landscape)" },
    { href: "/media/hero-poster-540.webp", as: "image", type: "image/webp", media: "(orientation: portrait)" },
  ]}
>
  <!-- 01 The story: swipe through the chapters -->
  <Story prints={featured} />

  <!-- 02 Contact -->
  <Slide id="contact" index={2} total={TOTAL} label="Contact" image={bgContact} dim={0.74} tall>
    <div class="contact">
      <div class="reveal">
        <p class="eyebrow">Say hello</p>
        <h2 id="contact-title">Let's grab a coffee</h2>
        <p class="lede">
          I'm no longer taking photography bookings. I've made photography a hobby and a passion again, away from the noise of the
          world and the criteria of clients.
        </p>
        <p class="lede">
          But if you want to talk photography, or hear what I've learned along the way, I'm always happy to grab a coffee. The same
          goes for brand and tech.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=Coffee%3F`}>Email me</a>
          <a class="btn" href={SITE.social.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        </div>
        <p class="socials">
          <a href={SITE.social.instagram} target="_blank" rel="me noopener">Instagram</a>
          <a href={SITE.social.youtube} target="_blank" rel="me noopener">YouTube</a>
          <a href="/photography">Photography</a>
        </p>
      </div>
      <div class="faq reveal">
        <h3>Happy to talk about</h3>
        <ul class="topics">
          <li>Getting started in automotive and motorsport photography</li>
          <li>Shooting film in 35mm and medium format</li>
          <li>Moving from photography into software, and back again</li>
          <li>Brand, content and the tech that powers marketing</li>
        </ul>
      </div>
    </div>
    {
      latest.length > 0 && (
        <div class="latest reveal">
          <h3>From the articles</h3>
          <ul>
            {latest.map((a) => (
              <li>
                <a href={`/articles/${a.slug}`}>{a.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Slide>
</Base>

<style>
  .hero-title {
    font-size: clamp(3.2rem, 11vw, 8.5rem);
    line-height: 0.95;
    margin-bottom: 0.25em;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: var(--text);
    max-width: 30ch;
  }
  .beat-big {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 4.4rem);
    line-height: 1.05;
    margin-bottom: 0.4em;
  }
  .beat-small {
    color: var(--text-2);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }
  [data-align="right"] .beat-small {
    margin-left: auto;
    max-width: 40ch;
  }

  .head {
    max-width: 760px;
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
  }

  /* Services */
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    gap: 1.25rem;
  }
  .service {
    background: rgba(19, 17, 24, 0.72);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
  }
  .service-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .service-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }
  .num {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--gold);
  }
  .service h3 {
    margin: 0.3rem 0 0.4rem;
  }
  .service h3 a {
    text-decoration: none;
  }
  .outcome {
    color: var(--text);
    font-weight: 500;
    font-size: 0.98rem;
    margin-bottom: 0.5rem;
  }
  .desc {
    color: var(--text-2);
    font-size: 0.92rem;
    margin: 0;
  }

  /* Work */
  .work {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .work-item.wide {
    grid-column: span 2;
  }
  .work-item a {
    position: relative;
    display: block;
    height: 100%;
    min-height: 260px;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
  }
  .work-item :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .work-item a:hover :global(img) {
    transform: scale(1.04);
  }
  .work-meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1.1rem 1rem;
    background: linear-gradient(to top, rgba(11, 10, 14, 0.9), transparent);
    display: grid;
  }
  .work-cat {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .work-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text);
  }
  .more {
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .work {
      grid-template-columns: 1fr;
    }
    .work-item.wide {
      grid-column: auto;
    }
  }

  /* Clients */
  .logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.75rem;
  }
  .logos li {
    background: var(--paper);
    border-radius: var(--radius);
    height: 92px;
    display: grid;
    place-items: center;
    padding: 0.9rem 1.1rem;
  }
  .logos a {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 520px) {
    .logos {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .logos li {
      height: 64px;
      padding: 0.5rem 0.6rem;
    }
  }
  .logos :global(img) {
    max-height: 56px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.85;
    transition: filter 0.3s, opacity 0.3s;
  }
  .logos li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  /* Testimonials: CSS scroll-snap carousel */
  .quotes-wrap {
    margin-inline: calc(-1 * var(--gutter));
  }
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(420px, 82vw);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }
  .quote {
    scroll-snap-align: start;
    background: rgba(19, 17, 24, 0.78);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    backdrop-filter: blur(6px);
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.55;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
  }
  .who :global(img) {
    border-radius: 50%;
    width: 44px;
    height: 44px;
    object-fit: cover;
  }
  .who span {
    display: grid;
  }
  .who span span {
    color: var(--text-3);
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .socials {
    display: flex;
    gap: 1.25rem;
    color: var(--text-2);
  }
  .faq h3 {
    font-size: 1.3rem;
  }
  details {
    border-top: 1px solid var(--line);
    padding: 0.9rem 0;
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::after {
    content: "+";
    color: var(--gold);
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    color: var(--text-2);
    margin: 0.6rem 0 0;
  }
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topics li {
    border-top: 1px solid var(--line);
    padding: 0.85rem 0;
    color: var(--text-2);
  }
  .topics li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .latest {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .latest h3 {
    font-size: 1rem;
    font-family: var(--font-body);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .latest ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem 2rem;
  }
  .latest a {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-decoration: none;
  }
  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
