---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { abs, breadcrumbSchema, PERSON_ID } from "../../lib/schema";
import header from "../../assets/photos/wall-header.jpg";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Play", path: "/play" },
  { name: "Through the Wall", path: "/play/through-the-wall" },
];
const schema = [
  breadcrumbSchema(crumbs),
  {
    "@type": "VideoGame",
    name: "Through the Wall",
    alternateName: "Cutout pose game",
    url: abs("/play/through-the-wall"),
    description:
      "A free webcam game for one or two players. A wall with a person-shaped hole rushes towards you and you strike the pose to fit through. Body tracking runs in your browser and the video never leaves your device.",
    genre: ["Action", "Fitness"],
    gamePlatform: "Web browser",
    applicationCategory: "Game",
    operatingSystem: "Any",
    playMode: ["SinglePlayer", "MultiPlayer"],
    author: { "@id": PERSON_ID },
    offers: { "@type": "Offer", price: "0", priceCurrency: "MYR" },
  },
];
---

<Base image="/og/play.jpg" imageAlt="Through the Wall: a wall with a person-shaped hole and a tracked skeleton"
  title="Through the Wall: a free webcam pose game"
  description="Strike the pose to fit through the hole in the wall. A free webcam game for one or two players that tracks your body in the browser. Private: the video never leaves your device."
  schema={schema}
>
  <PageHero image={header} eyebrow="Play · Webcam game" title="Through the Wall"
    intro="A wall with a person-shaped hole rushes at you. Strike the pose before it arrives or it smashes you. Your webcam tracks your whole body, for one or two players, and it all runs on your device: the video is never uploaded."
    compact crumbs={crumbs} />

  <section class="wrap game" data-wall>
    <div class="play">
    <aside class="guide" aria-label="The pose to strike">
      <p class="g-label">Strike this pose</p>
      <canvas data-guide width="320" height="360"></canvas>
      <p class="g-name" data-guide-name>Waiting for the first wall</p>
    </aside>
    <div class="stage" data-stage style="--ar:4 / 3">
      <video data-video playsinline muted></video>
      <canvas data-canvas aria-label="Camera view with the wall and your tracked skeleton"></canvas>

      <div class="hud">
        {
          [0, 1].map((i) => (
            <div class="p" data-hud={i} style={`--c:${i === 0 ? "#e8a25a" : "#6ec1e4"}`} hidden={i === 1}>
              <span class="who">{i === 0 ? "P1" : "P2"}</span>
              <b data-score>0</b>
              <span class="lives" data-lives>♥♥♥</span>
            </div>
          ))
        }
        <div class="mid"><span data-wave></span><strong data-pose></strong></div>
      </div>

      <div class="idle">
        <p class="best">Best score <b data-best>0</b></p>
        <p data-status role="status">Stand 2 to 3 metres from the camera so your whole body is in view, in a well-lit room.</p>
        <div class="modes" role="group" aria-label="Players">
          <button type="button" class="pill" data-mode="1" aria-pressed="true">1 player</button>
          <button type="button" class="pill" data-mode="2" aria-pressed="false">2 players</button>
        </div>
        <button type="button" class="btn btn-primary" data-start>Start</button>
      </div>

      <div class="over" data-over hidden></div>
      <button type="button" class="btn stop" data-stop disabled>Stop</button>
    </div>
    </div>
    <ol class="how">
      <li><b>Fit the hole.</b> Copy the cutout with your arms, legs and body. The green, amber and red lines on your skeleton show which limbs are right.</li>
      <li><b>Hold it.</b> You pass by holding the shape for a third of a second as the wall arrives. Where you stand and how big you look don't matter.</li>
      <li><b>Three lives.</b> Each miss costs a heart. The walls get faster and the poses harder. Two players share one wall and one hole each.</li>
    </ol>
  </section>
</Base>

<style>
  .game { padding-block: 2rem 5rem; display: grid; gap: 1.5rem; }
  .play { display: grid; gap: 1rem; grid-template-columns: 1fr; align-items: start; }
  .guide { background: var(--ink-2); border: 1px solid var(--line); border-radius: var(--radius); padding: .8rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: .5rem; min-width: 0; }
  .g-label { margin: 0; font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--gold); }
  .guide canvas { position: static; display: block; width: 100%; height: auto; max-width: 260px; aspect-ratio: 320 / 360; background: #0b0a0e; border-radius: 8px; }
  .g-name { margin: 0; font-family: var(--font-display); font-size: 1.05rem; }
  @media (max-width: 899px) {
    .guide { display: grid; grid-template-columns: 130px 1fr; text-align: left; justify-items: start; align-items: center; column-gap: 1rem; }
    .g-label { grid-column: 2; grid-row: 1; align-self: end; }
    .guide canvas { grid-column: 1; grid-row: 1 / 3; max-width: 130px; }
    .g-name { grid-column: 2; grid-row: 2; align-self: start; }
  }
  @media (min-width: 900px) { .play { grid-template-columns: 270px 1fr; } .guide { position: sticky; top: 5.5rem; } }
  .stage { position: relative; aspect-ratio: var(--ar); width: min(100%, calc(78svh * var(--arn, 1.3333))); margin-inline: auto; background: #000; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .stage video, .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: none; }
  .stage video { transform: scaleX(-1); filter: brightness(0.55) saturate(0.8); }
  :global(.live) .stage video, :global(.live) .stage canvas { display: block; }
  .idle { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.1rem; padding: 1.5rem; text-align: center; background: radial-gradient(circle at 50% 40%, var(--ink-3), var(--ink)); }
  :global(.live) .idle { display: none; }
  .idle p { margin: 0; max-width: 38ch; color: var(--text-2); }
  .idle p:global(.err) { color: #ff9a8a; }
  .best b { color: var(--gold); margin-left: .3rem; }
  .modes { display: flex; gap: .5rem; }
  .pill { padding: .5rem 1.1rem; border-radius: 999px; border: 1px solid var(--line-strong); background: none; color: var(--text); font: inherit; font-size: .9rem; cursor: pointer; }
  .pill[aria-pressed="true"] { background: var(--gold); border-color: var(--gold); color: var(--gold-ink); }
  .hud { position: absolute; inset: 0 0 auto 0; display: none; justify-content: space-between; align-items: flex-start; padding: .7rem .9rem; pointer-events: none; gap: .5rem; }
  :global(.live) .hud { display: flex; }
  .p { display: flex; align-items: baseline; gap: .55rem; padding: .35rem .8rem; border-radius: 999px; background: rgba(11,10,14,.7); border: 1px solid var(--c); font-size: .85rem; }
  .p[hidden] { display: none; }
  .p b { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .who { color: var(--c); font-weight: 700; }
  .lives { color: #ff6b5e; letter-spacing: .1em; }
  .mid { text-align: center; text-shadow: 0 1px 6px #000; display: grid; }
  .mid span { font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--text-2); }
  .mid strong { font-family: var(--font-display); font-size: 1.05rem; }
  .stop { position: absolute; right: .8rem; bottom: .8rem; padding: .45rem 1rem; font-size: .8rem; background: rgba(11,10,14,.6); display: none; }
  :global(.live) .stop { display: inline-flex; }
  .over { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1rem; background: rgba(11,10,14,.82); text-align: center; }
  .over[hidden] { display: none; }
  .over :global(h2) { margin: 0; font-family: var(--font-display); font-size: clamp(1.6rem, 4vw, 2.4rem); }
  .over :global(ul) { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; min-width: 14rem; }
  .over :global(li) { display: flex; align-items: center; gap: .6rem; font-size: 1.1rem; }
  .over :global(li i) { width: .7rem; height: .7rem; border-radius: 50%; background: var(--c); }
  .over :global(li b) { margin-left: auto; font-variant-numeric: tabular-nums; }
  .over :global(p) { margin: 0; color: var(--text-2); }
  .how { margin: 0; padding-left: 1.2rem; color: var(--text-2); display: grid; gap: .5rem; max-width: 70ch; font-size: .95rem; }
  .how b { color: var(--text); }
</style>

<script>
  import { mountWall } from "../../scripts/wall/game";
  const root = document.querySelector<HTMLElement>("[data-wall]");
  if (root) mountWall(root);
</script>
