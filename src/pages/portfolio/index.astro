---
// Portfolio: the work, the clients and what they said, on one page. This is the quick answer to "what can you do?".
// Personal and travel albums live in /gallery, so this page stays about work.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import FlickrImg from "../../components/FlickrImg.astro";
import { getAlbums, CATEGORY_LABELS, isPassion } from "../../lib/flickr";
import { breadcrumbSchema, faqSchema, abs, PERSON_ID } from "../../lib/schema";
import { DEV_PROJECTS } from "../../data/projects";
import { FLAGS, SITE } from "../../config/site";
import { SERVICES, CLIENTS, TESTIMONIALS, FAQ, VIDEOS } from "../../data/content";
import header from "../../assets/photos/automotive-header.jpg";

const brandFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/brands/*", { eager: true });
const faceFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/testimonials/*", { eager: true });
const brand = (f: string) => brandFiles[`../../assets/brands/${f}`]?.default;
const face = (f: string) => faceFiles[`../../assets/testimonials/${f}`]?.default;

const albums = (await getAlbums()).filter((a) => !isPassion(a));
const counts = new Map<string, number>();
for (const a of albums) for (const c of a.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]).map(([c]) => c);
const devProjects = FLAGS.showDevProjects ? DEV_PROJECTS : [];
const totalPhotos = albums.reduce((n, a) => n + a.count, 0);

const filterCss =
  cats.map((c) => `.portfolio:has(#f-${c}:checked) .album:not([data-cats~="${c}"]){display:none}`).join("\n") +
  `\n.portfolio:has(#f-video:checked) .album:not([data-cats~="video"]){display:none}`;

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Portfolio", path: "/portfolio" },
];
const schema = [
  breadcrumbSchema(crumbs),
  faqSchema(FAQ),
  {
    "@type": "CollectionPage",
    name: "Portfolio of andriantam",
    url: abs("/portfolio"),
    author: { "@id": PERSON_ID },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: albums.map((a, i) => ({ "@type": "ListItem", position: i + 1, url: abs(`/portfolio/${a.slug}`), name: a.title })),
    },
  },
];
---

<Base image="/og/portfolio.jpg" imageAlt="A motorsport photo by andriantam: a race car at speed"
  title="Portfolio: photography and video work, clients and testimonials"
  description={`Automotive, motorsport, event and wedding photography and video by Andrian Tam: ${albums.length} albums and ${CLIENTS.length} clients, including Motul and MG.`}
  schema={schema}
>
  <PageHero
    image={header}
    eyebrow="Portfolio"
    title="The work"
    intro={`${albums.length} albums and ${totalPhotos.toLocaleString("en")} photos for ${CLIENTS.length} clients: automotive and motorsport, events, weddings, products and video. I'm not taking regular jobs for now, but I'm open to creative projects.`}
    crumbs={crumbs}
  >
    <p class="hero-actions">
      <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=A%20creative%20project`}>Pitch me something creative</a>
      <a class="btn" href="#voices">What clients said</a>
      <a class="btn" href="#albums">See the albums</a>
    </p>
  </PageHero>

  <!-- What I do -->
  <section class="wrap block" aria-labelledby="can-title">
    <p class="eyebrow">What I do</p>
    <h2 id="can-title">Photo, video and the tech around them</h2>
    <ul class="can">
      {
        SERVICES.map((s) => (
          <li>
            <strong>{s.href && s.href !== "/portfolio" ? <a href={s.href}>{s.title}</a> : s.title}</strong>
            <span>{s.outcome}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Clients -->
  <section class="wrap block" aria-labelledby="clients-title">
    <p class="eyebrow">Worked with</p>
    <h2 id="clients-title">Brands, events and owners' clubs</h2>
    <ul class="logos">
      {
        CLIENTS.map((c) => {
          const img = brand(c.file);
          if (!img) return null;
          const logo = <Image src={img} alt={c.name} height={120} densities={[1, 2]} format="webp" />;
          return <li title={c.name}>{c.url ? <a href={c.url} target="_blank" rel="noopener">{logo}</a> : logo}</li>;
        })
      }
    </ul>
  </section>

  <!-- Testimonials -->
  <section class="block" id="voices" aria-labelledby="voices-title">
    <div class="wrap">
      <p class="eyebrow">Kind words</p>
      <h2 id="voices-title">What clients said</h2>
    </div>
    <div class="wrap">
      <div class="quotes-wrap">
        <ul class="quotes" tabindex="0" aria-label="Testimonials, scroll sideways">
          {
            TESTIMONIALS.map((t) => {
              const img = face(t.photo);
              return (
                <li class="quote">
                  <blockquote>
                    <p>“{t.quote}”</p>
                  </blockquote>
                  <div class="who">
                    {img && <Image src={img} alt="" width={56} height={56} densities={[1, 2]} format="webp" />}
                    <span>
                      <strong>{t.name}</strong>
                      <span>{t.context}</span>
                    </span>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </section>

  <style set:html={filterCss}></style>

  <!-- Albums -->
  <section class="portfolio wrap block" id="albums" aria-labelledby="albums-title">
    <p class="eyebrow">Albums</p>
    <h2 id="albums-title">Pick a kind of work</h2>
    <fieldset class="filters" aria-label="Filter albums">
      <legend class="sr-only">Filter by category</legend>
      <input type="radio" name="cat" id="f-all" checked /><label for="f-all">All</label>
      {
        cats.map((c) => (
          <>
            <input type="radio" name="cat" id={`f-${c}`} />
            <label for={`f-${c}`}>{CATEGORY_LABELS[c] ?? c}</label>
          </>
        ))
      }
      <input type="radio" name="cat" id="f-video" /><label for="f-video">Video</label>
    </fieldset>
    <ul class="albums">
      <li class="album video-card" data-cats="video">
        <a href="/portfolio/videography">
          <img src={`https://i.ytimg.com/vi/${VIDEOS[0].id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
          <span class="meta">
            <span class="cat">Video</span>
            <span class="title">Videography</span>
            <span class="count">{VIDEOS.length} films and reels</span>
          </span>
        </a>
      </li>
      {
        albums.map((a) =>
          a.cover ? (
            <li class="album reveal" data-cats={a.categories.join(" ")}>
              <a href={`/portfolio/${a.slug}`}>
                <FlickrImg photo={a.cover} alt={`${a.title}, photographed by andriantam`} sizes="(min-width: 1100px) 380px, (min-width: 700px) 50vw, 100vw" />
                <span class="meta">
                  <span class="cat">{a.categories.map((c) => CATEGORY_LABELS[c] ?? c).join(" · ")}</span>
                  <span class="title">{a.title}</span>
                  <span class="count">{a.count} photos</span>
                </span>
              </a>
            </li>
          ) : null,
        )
      }
    </ul>

    {
      devProjects.length > 0 && (
        <section class="dev" aria-labelledby="dev-title">
          <h2 id="dev-title">Web and software</h2>
          <ul>
            {devProjects.map((p) => (
              <li>
                <a href={`/portfolio/${p.type}/${p.slug}`}>
                  <span class="cat">{p.type === "web" ? "Web" : "Software"} · {p.year}</span>
                  <span class="title">{p.title}</span>
                  <span class="count">{p.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <p class="aside">Looking for the personal work? Travel, night skies and film are in the <a href="/gallery">gallery</a>.</p>
  </section>

  <!-- Availability and questions -->
  <section class="wrap block" aria-labelledby="questions-title">
    <div class="contact">
      <div>
        <p class="eyebrow">Open to creative projects</p>
        <h2 id="questions-title">Got something worth making?</h2>
        <p class="lede">
          Photography started as a hobby and became a business. When every frame was for money, the creativity went, so I stopped
          taking regular clients. If you have something more creative in mind, I'm open to it.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=A%20creative%20project`}>Email me</a>
          <a class="btn" href={SITE.social.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
        </div>
      </div>
      <div class="faq">
        <h3>Common questions</h3>
        {
          FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .block {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .block h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    margin: 0 0 1.5rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0 0;
  }
  .can {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0 2.5rem;
  }
  .can li {
    display: grid;
    gap: 0.1rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--line);
  }
  .can span {
    color: var(--text-2);
    font-size: 0.92rem;
  }
  .aside {
    margin-top: 2rem;
    color: var(--text-2);
  }

  .filters {
    border: 0;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filters input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .filters label {
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--text-2);
    cursor: pointer;
    transition: all 0.2s;
  }
  .filters input:checked + label {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--gold-ink);
  }
  .filters input:focus-visible + label {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .albums,
  .dev ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
  }
  .album a {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--ink-2);
  }
  .album :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .album a:hover :global(img) {
    transform: scale(1.05);
  }
  .meta {
    position: absolute;
    inset: auto 0 0 0;
    padding: 3rem 1rem 0.9rem;
    background: linear-gradient(to top, rgba(11, 10, 14, 0.92), transparent);
    display: grid;
    gap: 0.1rem;
  }
  .cat {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--text);
  }
  .count {
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .dev {
    margin-top: 5rem;
  }
  .dev a {
    display: grid;
    gap: 0.3rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .hero-title {
    font-size: clamp(3.2rem, 11vw, 8.5rem);
    line-height: 0.95;
    margin-bottom: 0.25em;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    color: var(--text);
    max-width: 30ch;
  }
  .beat-big {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 4.4rem);
    line-height: 1.05;
    margin-bottom: 0.4em;
  }
  .beat-small {
    color: var(--text-2);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
  }
  [data-align="right"] .beat-small {
    margin-left: auto;
    max-width: 40ch;
  }

  /* Clients */
  .logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.75rem;
  }
  .logos li {
    background: var(--paper);
    border-radius: var(--radius);
    height: 92px;
    display: grid;
    place-items: center;
    padding: 0.9rem 1.1rem;
  }
  .logos a {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 520px) {
    .logos {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }
    .logos li {
      height: 64px;
      padding: 0.5rem 0.6rem;
    }
  }
  .logos :global(img) {
    max-height: 56px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1) contrast(1.1);
    opacity: 0.85;
    transition: filter 0.3s, opacity 0.3s;
  }
  .logos li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  /* Testimonials: CSS scroll-snap carousel */
  .quotes-wrap {
    margin-inline: calc(-1 * var(--gutter));
  }
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0.5rem var(--gutter) 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(420px, 82vw);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--gold) transparent;
  }
  .quote {
    scroll-snap-align: start;
    background: rgba(19, 17, 24, 0.78);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    backdrop-filter: blur(6px);
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.55;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
  }
  .who :global(img) {
    border-radius: 50%;
    width: 44px;
    height: 44px;
    object-fit: cover;
  }
  .who span {
    display: grid;
  }
  .who span span {
    color: var(--text-3);
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .socials {
    display: flex;
    gap: 1.25rem;
    color: var(--text-2);
  }
  .faq h3 {
    font-size: 1.3rem;
  }
  details {
    border-top: 1px solid var(--line);
    padding: 0.9rem 0;
  }
  details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  summary::after {
    content: "+";
    color: var(--gold);
  }
  details[open] summary::after {
    content: "–";
  }
  details p {
    color: var(--text-2);
    margin: 0.6rem 0 0;
  }
  .latest {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .latest h3 {
    font-size: 1rem;
    font-family: var(--font-body);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .latest ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem 2rem;
  }
  .latest a {
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-decoration: none;
  }
  @media (max-width: 820px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }  @media (max-width: 700px) {
    .albums {
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .albums .title {
      font-size: 0.95rem;
    }
    .albums .count {
      display: none;
    }
  }
</style>
