---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { VIDEOS, REELS } from "../../data/content";
import { abs, breadcrumbSchema, PERSON_ID } from "../../lib/schema";
import header from "../../assets/photos/testimonials-bg.jpg";

const schema = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Portfolio", path: "/portfolio" },
    { name: "Videography", path: "/portfolio/videography" },
  ]),
  ...VIDEOS.map((v) => ({
    "@type": "VideoObject",
    name: v.title,
    description: `${v.title}. Filmed by andriantam.`,
    thumbnailUrl: `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${v.id}`,
    contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
    uploadDate: undefined,
    creator: { "@id": PERSON_ID },
    url: abs(`/videography/${v.id}`),
  })),
];
---

<Base image="/og/portfolio.jpg" imageAlt="A motorsport photo by andriantam: a race car at speed"
  title="Videography"
  description="Cinematic event films, motorsport coverage and vertical reels by andriantam, formerly Tam's Up Productions. Watch the latest videography projects and reels."
  schema={schema}
>
  <PageHero
    image={header}
    eyebrow="Video"
    title="Videography"
    intro="Event recaps, motorsport and brand films shot with a cinematic tone, in wide format and vertical reels. Formerly Tam's Up Productions."
    compact
    crumbs={[{ name: "Home", path: "/" }, { name: "Portfolio", path: "/portfolio" }, { name: "Videography", path: "/portfolio/videography" }]}
  />

  <section class="wrap videos">
    <ul class="films">
      {
        VIDEOS.map((v) => (
          <li class="reveal">
            <button class="yt" type="button" data-yt={v.id} aria-label={`Play ${v.title}`}>
              <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
              <span class="play" aria-hidden="true" />
            </button>
            <h2><a href={`/videography/${v.id}`}>{v.title}</a></h2>
            {v.client !== "andriantam" && <p class="client">For {v.client}</p>}
          </li>
        ))
      }
    </ul>

    <h2 class="reels-title">Reels on Instagram</h2>
    <ul class="reels">
      {REELS.map((r, i) => <li><a class="btn" href={r} target="_blank" rel="noopener">Watch reel {i + 1} on Instagram ↗</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .videos {
    padding-bottom: 6rem;
  }
  .films {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 2rem 1.25rem;
  }
  .films h2 {
    font-size: 1.25rem;
    margin: 0.9rem 0 0.2rem;
  }
  .films h2 a {
    color: inherit;
    text-decoration: none;
  }
  .films h2 a:hover {
    text-decoration: underline;
  }
  .client {
    color: var(--text-3);
    font-size: 0.9rem;
  }
  .yt {
    all: unset;
    cursor: pointer;
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
  }
  .yt:focus-visible {
    outline: 2px solid var(--gold);
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(11, 10, 14, 0.7);
    border: 1px solid var(--gold);
  }
  .play::after {
    content: "";
    position: absolute;
    left: 27px;
    top: 21px;
    border-left: 20px solid var(--gold);
    border-top: 13px solid transparent;
    border-bottom: 13px solid transparent;
  }
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .reels-title {
    margin-top: 4rem;
    font-size: 1.6rem;
  }
  .reels {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

<script>
  // YouTube facade: the heavy player only loads when someone clicks play.
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-yt]")) {
    btn.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      iframe.title = btn.getAttribute("aria-label")?.replace("Play ", "") ?? "YouTube video";
      btn.replaceChildren(iframe);
    }, { once: true });
  }
</script>
